{{ 'edp-ai.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ai_answer = nil
  assign ai_spec = nil
  assign ai_faq = nil
  assign ai_related_products = nil
  assign ai_related_collections = nil

  if resource == blank
    if request.page_type == 'product'
      assign resource = product
    elsif request.page_type == 'collection'
      assign resource = collection
    elsif request.page_type == 'page'
      assign resource = page
    elsif request.page_type == 'article'
      assign resource = article
    endif
  endif

  if resource
    assign ai_answer = resource.metafields.seo.kort_text_150.value
    assign ai_spec = resource.metafields.seo.specification.value
    assign ai_faq = resource.metafields.seo.faq_json.value
    assign ai_related_products = resource.metafields.seo.related_products.value
    assign ai_related_collections = resource.metafields.seo.related_collections.value
  endif

  assign has_ai_content = false
  if ai_answer != blank or ai_spec != blank or ai_faq != blank
    assign has_ai_content = true
  endif
-%}

{%- if has_ai_content -%}
  <aside class="edp-ai" data-edp-ai-content>
    {% render 'edp-ai-answer', resource: resource %}
    {% render 'edp-ai-spec', resource: resource %}
    {% render 'edp-ai-faq', resource: resource %}
    {% render 'edp-ai-related', resource: resource %}
  </aside>
{%- endif -%}
