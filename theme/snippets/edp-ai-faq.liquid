{%- liquid
  assign ai_faq = resource.metafields.seo.faq_json.value
-%}
{%- if ai_faq != blank and ai_faq.size > 0 -%}
  <section class="edp-ai__faq" id="edp-ai-faq"{% if block %} {{ block.shopify_attributes }}{% endif %}>
    <h2 class="edp-ai__heading">Vanliga frågor</h2>
    <div class="edp-ai__faq-list">
      {%- for item in ai_faq -%}
        {%- assign question = item.question | default: item.q | strip_html | strip -%}
        {%- assign answer = item.answer | default: item.a | strip_html | strip -%}
        {%- if question != blank and answer != blank -%}
          <details class="edp-ai__faq-item">
            <summary>{{ question | escape }}</summary>
            <p>{{ answer | escape }}</p>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}
