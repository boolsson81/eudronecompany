{%- liquid
  assign edp_robots_noindex = false

  if request.page_type == '404' or request.page_type == 'cart' or request.page_type == 'search'
    assign edp_robots_noindex = true
  elsif request.page_type contains 'customers'
    assign edp_robots_noindex = true
  endif
-%}
{%- if edp_robots_noindex -%}
  <meta name="robots" content="noindex, nofollow">
{%- endif -%}
