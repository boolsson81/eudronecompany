{% comment %}
  Renders the actual "choose your drone" <select> + search field.

  Accepts:
  - section: {Object} parent section (for id + settings)
  - compat_filter: {Object} the collection.filters entry for custom.passsar_till

  Submits a normal GET request to the collection URL, preserving any other
  active filters/sort as hidden inputs, so this never conflicts with or
  duplicates Shopify's own facet filtering.
{% endcomment %}
<form
  method="get"
  action="{{ collection.url }}"
  id="DronePickerForm-{{ section.id }}"
  class="drone-picker__form"
>
  {%- if collection.sort_by -%}
    <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
  {%- endif -%}
  {%- for filter in collection.filters -%}
    {%- unless filter.param_name == compat_filter.param_name -%}
      {%- for value in filter.active_values -%}
        <input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">
      {%- endfor -%}
    {%- endunless -%}
  {%- endfor -%}

  <div class="drone-picker__field">
    <label class="visually-hidden" for="DroneModel-{{ section.id }}">{{ 'products.drone_finder.select_label' | t }}</label>
    {%- if section.settings.enable_search -%}
      <div class="field drone-picker__search-field">
        <input
          type="search"
          id="DronePickerSearch-{{ section.id }}"
          class="drone-picker__search field__input"
          data-drone-picker-search="DroneModel-{{ section.id }}"
          placeholder="{{ 'products.drone_finder.search_placeholder' | t }}"
          autocomplete="off"
        >
        <label class="field__label" for="DronePickerSearch-{{ section.id }}">
          {{ 'products.drone_finder.search_placeholder' | t }}
        </label>
      </div>
    {%- endif -%}
    <div class="select">
      <select name="{{ compat_filter.param_name }}" id="DroneModel-{{ section.id }}" class="select__select">
        <option value="">{{ 'products.drone_finder.select_placeholder' | t }}</option>
        {%- for value in compat_filter.values -%}
          <option value="{{ value.value | escape }}" {% if value.active %}selected{% endif %}>
            {{- value.label -}} ({{ value.count }})
          </option>
        {%- endfor -%}
      </select>
    </div>
  </div>
  <noscript>
    <button type="submit" class="button button--primary">{{ 'products.facets.apply' | t }}</button>
  </noscript>
</form>

<script>
  (function () {
    var scope = document.getElementById('DronePickerForm-{{ section.id }}');
    if (!scope) return;

    var select = scope.querySelector('select[name]');
    if (select) {
      select.addEventListener('change', function () {
        if (select.value !== '') scope.submit();
      });
    }

    var search = scope.querySelector('[data-drone-picker-search]');
    if (search && select) {
      search.addEventListener('input', function () {
        var term = search.value.trim().toLowerCase();
        Array.prototype.forEach.call(select.options, function (option) {
          if (!option.value) return;
          var match = option.textContent.toLowerCase().indexOf(term) !== -1;
          option.hidden = term.length > 0 && !match;
        });
      });
    }
  })();
</script>
