{%- liquid
  assign ai_spec = resource.metafields.seo.specification.value
-%}
{%- if ai_spec != blank -%}
  <div class="product__accordion accordion edp-ai__spec"{% if block %} {{ block.shopify_attributes }}{% endif %}>
    <details id="edp-ai-description">
      <summary>
        <div class="summary__title">
          <h2 class="h4 accordion__title">Beskrivning</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content edp-ai__spec-body rte" id="edp-ai-description-content">
        {{ ai_spec }}
      </div>
    </details>
  </div>
{%- endif -%}
