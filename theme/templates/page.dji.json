      "blocks": {
        "row_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Säljer ni hela DJI:s sortiment?",
            "row_content": "<p>Vi för både konsumentserien (Mini, Air, Mavic, Avata, Neo, Flip) och enterpriseserien (Matrice, FlyCart, Agras) med tillhörande tillbehör och reservdelar.</p>"
          }
        },
        "row_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Är reservdelarna original från DJI?",
            "row_content": "<p>Ja, våra DJI-reservdelar är original, inte tredjepartskopior.</p>"
          }
        },
        "row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Kan jag få hjälp att välja rätt drönare?",
            "row_content": "<p>Kontakta oss så hjälper vi dig matcha modell mot uppdrag, oavsett om det är foto, kartläggning eller industriinspektion.</p>"
          }
        },
        "row_4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Hanterar ni garantiärenden?",
            "row_content": "<p>Ja, vi hjälper dig med garantiärenden på produkter köpta hos oss.</p>"
          }
        }
      },
