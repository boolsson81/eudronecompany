          }
        },
        "row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Säljer ni tillbehör separat?",
            "row_content": "<p>Ja, batterier, laddkablar, hardcase och reservpropellrar finns separat till befintliga Wingtra-system.</p>"
