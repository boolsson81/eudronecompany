{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Dela"
          }
        },
        "short": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign edc_short = product.metafields.seo.kort_text_150.value -%}{%- if edc_short != blank -%}<p class=\"product__text edc-short\">{{ edc_short | escape }}</p>{%- endif -%}"
          }
        },
        "payment": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-payment-icons' %}"
          }
        },
        "accordions": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-product-accordions' %}"
          }
        },
        "trust": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "check_mark",
            "heading_1": "Auktoriserad DJI Enterprise-partner",
            "icon_2": "check_mark",
            "heading_2": "Fakturaköp, leasing & offert",
            "icon_3": "check_mark",
            "heading_3": "Utbildning & driftsättning"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 10,
            "show_inventory_quantity": true
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "short",
        "caption",
        "price",
        "inventory",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust",
        "payment",
        "description",
        "accordions",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-edp",
        "media_size": "large",
        "constrain_to_viewport": true,
        "gallery_layout": "stacked",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "trust-badges": {
      "type": "multicolumn",
      "blocks": {
        "column-0": {
          "type": "column",
          "settings": {
            "title": "Auktoriserad DJI Enterprise-partner",
            "text": "<p>Officiell försäljning, service och reservdelar för Matrice, Agras, Dock och FlyCart.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column-1": {
          "type": "column",
          "settings": {
            "title": "Fakturaköp, leasing & offert",
            "text": "<p>Handla mot faktura med företagskonto, leasa plattformen eller begär offert för hela flottan.</p>",
            "link_label": "Begär offert",
            "link": "/pages/contact-quote"
          }
        },
        "column-2": {
          "type": "column",
          "settings": {
            "title": "Utbildning & driftsättning",
            "text": "<p>Vi hjälper er med drönarkort, operatörstillstånd och driftsättning på plats.</p>",
            "link_label": "Utbildningar",
            "link": "/pages/training"
          }
        }
      },
      "block_order": [
        "column-0",
        "column-1",
        "column-2"
      ],
      "settings": {
        "title": "",
        "heading_size": "h2",
        "image_width": "full",
        "image_ratio": "adapt",
        "button_label": "",
        "button_link": "",
        "columns_desktop": 3,
        "column_alignment": "left",
        "background_style": "none",
        "color_scheme": "scheme-edp",
        "columns_mobile": "1",
        "swipe_on_mobile": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Nyttolaster & tillbehör till plattformen",
        "heading_size": "h2",
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-edp",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "enterprise-quote": {
      "type": "enterprise-quote-form",
      "settings": {
        "title": "Osäker på vilken plattform som passar ert uppdrag?",
        "intro": "Beskriv uppdraget — inspektion, kartläggning, jordbruk eller räddningstjänst — så återkommer vårt enterprise-team med rekommendation och offert inom 24 timmar.",
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "faq": {
      "type": "edp-metafield-faq",
      "settings": {
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "accessories": {
      "type": "drone-compatible-products",
      "settings": {
        "collection_handle": "drone-accessories",
        "heading": "Passande tillbehör",
        "heading_size": "h2",
        "max_products": 8,
        "columns_desktop": 4,
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "spare-parts": {
      "type": "drone-compatible-products",
      "settings": {
        "collection_handle": "drone-spare-parts",
        "heading": "Reservdelar",
        "heading_size": "h2",
        "max_products": 8,
        "columns_desktop": 4,
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "docs": {
      "type": "edp-product-relations",
      "settings": {
        "show": "docs",
        "docs_heading": "Dokumentation & manualer",
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "sticky-atc": {
      "type": "edp-sticky-atc",
      "settings": {
        "color_scheme": "scheme-edp"
      }
    }
  },
  "order": [
    "main",
    "accessories",
    "spare-parts",
    "docs",
    "related-products",
    "enterprise-quote",
    "faq",
    "trust-badges",
    "sticky-atc"
  ]
}
