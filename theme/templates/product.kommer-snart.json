{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "availability_alert": {
          "type": "availability_alert",
          "settings": {
            "icon": "calendar",
            "heading": "Kommer snart",
            "text": "Skriv upp dig nedan så hör vi av oss så snart produkten går att beställa."
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "collapsible-row-0": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Tekniska specifikationer",
            "icon": "ruler",
            "content": "",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Dela"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "availability_alert",
        "description",
        "collapsible-row-0",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-edp",
        "media_size": "large",
        "constrain_to_viewport": true,
        "gallery_layout": "stacked",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "notify-me": {
      "type": "newsletter",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Var först att få veta",
            "heading_size": "h2"
          }
        },
        "paragraph": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Vi meddelar dig så snart produkten finns tillgänglig för köp.</p>"
          }
        },
        "email_form": {
          "type": "email_form",
          "settings": {}
        }
      },
      "block_order": ["heading", "paragraph", "email_form"],
      "settings": {
        "color_scheme": "scheme-edp",
        "full_width": false,
        "padding_top": 28,
        "padding_bottom": 36
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Utforska sortimentet under tiden",
        "heading_size": "h2",
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-edp",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 12,
        "padding_bottom": 36
      }
    }
  },
  "order": ["main", "notify-me", "related-products"]
}
