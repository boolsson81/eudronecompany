{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "package_badge": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-package-badge', product: product %}"
          }
        },
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "package_contents": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-package-contents', product: product %}"
          }
        },
        "package_addons": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-package-addons', product: product, section_id: section.id %}"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "collapsible-row-0": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Tekniska specifikationer",
            "icon": "ruler",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Så används paketet",
            "icon": "plane",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Utbildning & driftsättning",
            "icon": "clipboard",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-3": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Leverans, service & garanti",
            "icon": "truck",
            "content": "",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Dela"
          }
        }
      },
      "block_order": [
        "package_badge",
        "vendor",
        "title",
        "caption",
        "price",
        "package_contents",
        "package_addons",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "collapsible-row-0",
        "collapsible-row-1",
        "collapsible-row-2",
        "collapsible-row-3",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-edp",
        "media_size": "large",
        "constrain_to_viewport": true,
        "gallery_layout": "thumbnail_slider",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "trust-badges": {
      "type": "multicolumn",
      "blocks": {
        "column-0": {
          "type": "column",
          "settings": {
            "title": "Komplett och redo att driftsättas",
            "text": "<p>Alla delar i paketet är testade tillsammans och levereras som en helhet – inga dolda tillägg för att komma igång.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column-1": {
          "type": "column",
          "settings": {
            "title": "Fakturaköp, leasing & offert",
            "text": "<p>Handla mot faktura med företagskonto, leasa paketet eller begär offert för en anpassad konfiguration.</p>",
            "link_label": "Begär offert",
            "link": "/pages/contact-quote"
          }
        },
        "column-2": {
          "type": "column",
          "settings": {
            "title": "Utbildning & driftsättning",
            "text": "<p>Vi hjälper er med drönarkort, operatörstillstånd och driftsättning på plats.</p>",
            "link_label": "Utbildningar",
            "link": "/pages/service-support"
          }
        }
      },
      "block_order": [
        "column-0",
        "column-1",
        "column-2"
      ],
      "settings": {
        "title": "",
        "heading_size": "h2",
        "image_width": "full",
        "image_ratio": "adapt",
        "button_label": "",
        "button_link": "",
        "columns_desktop": 3,
        "column_alignment": "left",
        "background_style": "none",
        "color_scheme": "scheme-edp",
        "columns_mobile": "1",
        "swipe_on_mobile": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "product-relations": {
      "type": "edp-product-relations",
      "settings": {
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Fler tillbehör till paketet",
        "heading_size": "h2",
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-edp",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "enterprise-quote": {
      "type": "enterprise-quote-form",
      "settings": {
        "title": "Vill ni anpassa paketet?",
        "intro": "Beskriv uppdraget och vad som behöver bytas ut eller läggas till – fler batterier, annan nyttolast eller utbildning – så återkommer vårt enterprise-team med ett skräddarsytt paket och offert inom 24 timmar.",
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "main",
    "trust-badges",
    "product-relations",
    "related-products",
    "enterprise-quote"
  ]
}
