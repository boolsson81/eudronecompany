{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "short": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign edc_short = product.metafields.seo.kort_text_150.value -%}{%- if edc_short != blank -%}<p class=\"product__text edc-short\">{{ edc_short | escape }}</p>{%- endif -%}"
          }
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "series": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign drone_series = product.metafields.dji.series.value -%}{%- if drone_series != blank -%}<p class=\"product__text caption-with-letter-spacing product__series\">{{ 'products.product.series_label' | t }}{%- for serie in drone_series -%}{{ serie | escape }}{%- unless forloop.last -%}, {%- endunless -%}{%- endfor -%}</p>{%- endif -%}"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Dela"
          }
        },
        "payment": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-payment-icons' %}"
          }
        },
        "accordions": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-product-accordions' %}"
          }
        },
        "trust": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "check_mark",
            "heading_1": "Auktoriserad DJI-återförsäljare",
            "icon_2": "check_mark",
            "heading_2": "Skickas från lager inom 1–2 vardagar",
            "icon_3": "check_mark",
            "heading_3": "Full tillverkargaranti"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 10,
            "show_inventory_quantity": true
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "short",
        "caption",
        "series",
        "price",
        "inventory",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust",
        "payment",
        "description",
        "accordions",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "thumbnail",
        "media_position": "left",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "trust-badges": {
      "type": "multicolumn",
      "blocks": {
        "column-0": {
          "type": "column",
          "settings": {
            "title": "Auktoriserad DJI-återförsäljare",
            "text": "<p>Äkta drönare med full tillverkargaranti och svensk kundsupport — aldrig gråimport.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column-1": {
          "type": "column",
          "settings": {
            "title": "Redo att flyga",
            "text": "<p>Skickas från lager inom 1–2 vardagar med spårbar frakt. Batterier fraktas enligt gällande regler.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column-2": {
          "type": "column",
          "settings": {
            "title": "Drönarkort & regler",
            "text": "<p>Vi hjälper dig flyga lagligt: registrering hos Transportstyrelsen och A1/A3-certifiering.</p>",
            "link_label": "Läs mer",
            "link": "/pages/service-support"
          }
        }
      },
      "block_order": [
        "column-0",
        "column-1",
        "column-2"
      ],
      "settings": {
        "title": "",
        "heading_size": "h2",
        "image_width": "full",
        "image_ratio": "adapt",
        "columns_desktop": 3,
        "column_alignment": "left",
        "background_style": "none",
        "button_label": "",
        "button_link": "",
        "swipe_on_mobile": false,
        "color_scheme": "scheme-edp",
        "columns_mobile": "1",
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Du kanske också gillar",
        "heading_size": "h2",
        "columns_desktop": 4,
        "color_scheme": "scheme-edp",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "faq": {
      "type": "edp-metafield-faq",
      "settings": {
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "accessories": {
      "type": "drone-compatible-products",
      "settings": {
        "collection_handle": "drone-accessories",
        "heading": "Passande tillbehör",
        "heading_size": "h2",
        "max_products": 8,
        "columns_desktop": 4,
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "spare-parts": {
      "type": "drone-compatible-products",
      "settings": {
        "collection_handle": "drone-spare-parts",
        "heading": "Reservdelar",
        "heading_size": "h2",
        "max_products": 8,
        "columns_desktop": 4,
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "docs": {
      "type": "edp-product-relations",
      "settings": {
        "show": "docs",
        "docs_heading": "Dokumentation & manualer",
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "sticky-atc": {
      "type": "edp-sticky-atc",
      "settings": {
        "color_scheme": "scheme-edp"
      }
    }
  },
  "order": [
    "main",
    "accessories",
    "spare-parts",
    "docs",
    "related-products",
    "faq",
    "trust-badges",
    "sticky-atc"
  ]
}
