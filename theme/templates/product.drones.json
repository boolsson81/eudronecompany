{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "series": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign drone_series = product.metafields.dji.series.value -%}{%- if drone_series != blank -%}<p class=\"product__text caption-with-letter-spacing product__series\">Serie: {%- for serie in drone_series -%}{{ serie | escape }}{%- unless forloop.last -%}, {%- endunless -%}{%- endfor -%}</p>{%- endif -%}"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "collapsible-row-0": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Tekniska specifikationer",
            "icon": "ruler",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Flygtid & räckvidd",
            "icon": "stopwatch",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "I paketet ingår",
            "icon": "box",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-3": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Regler, drönarkort & registrering",
            "icon": "clipboard",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-4": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Leverans, garanti & retur",
            "icon": "truck",
            "content": "",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Dela"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "caption",
        "series",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "collapsible-row-0",
        "collapsible-row-1",
        "collapsible-row-2",
        "collapsible-row-3",
        "collapsible-row-4",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "trust-badges": {
      "type": "multicolumn",
      "blocks": {
        "column-0": {
          "type": "column",
          "settings": {
            "title": "Auktoriserad DJI-återförsäljare",
            "text": "<p>Äkta drönare med full tillverkargaranti och svensk kundsupport — aldrig gråimport.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column-1": {
          "type": "column",
          "settings": {
            "title": "Redo att flyga",
            "text": "<p>Skickas från lager inom 1–2 vardagar med spårbar frakt. Batterier fraktas enligt gällande regler.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column-2": {
          "type": "column",
          "settings": {
            "title": "Drönarkort & regler",
            "text": "<p>Vi hjälper dig flyga lagligt: registrering hos Transportstyrelsen och A1/A3-certifiering.</p>",
            "link_label": "Läs mer",
            "link": "/pages/training"
          }
        }
      },
      "block_order": ["column-0", "column-1", "column-2"],
      "settings": {
        "title": "",
        "heading_size": "h2",
        "image_width": "full",
        "image_ratio": "adapt",
        "columns_desktop": 3,
        "column_alignment": "left",
        "background_style": "none",
        "button_label": "",
        "button_link": "",
        "swipe_on_mobile": false,
        "color_scheme": "scheme-edp",
        "columns_mobile": "1",
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Tillbehör till din drönare",
        "heading_size": "h2",
        "columns_desktop": 4,
        "color_scheme": "scheme-edp",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": ["main", "trust-badges", "related-products"]
}
