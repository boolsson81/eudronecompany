{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "compatibility": {
          "type": "text",
          "settings": {
            "text": "Kompatibilitetsstatus visas nedan under \"Kompatibla UAV-plattformar\".",
            "text_style": "uppercase"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "collapsible-row-0": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Vad ingår",
            "icon": "box",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Leverans, service & garanti",
            "icon": "truck",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Dokumentation & nedladdningar",
            "icon": "clipboard",
            "content": "",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Dela"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "caption",
        "compatibility",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "collapsible-row-0",
        "collapsible-row-1",
        "collapsible-row-2",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-edp",
        "media_size": "large",
        "constrain_to_viewport": true,
        "gallery_layout": "stacked",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "payload-details": {
      "type": "edp-payload-details",
      "settings": {
        "color_scheme": "scheme-edp",
        "quote_link": "/pages/contact-quote"
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Andra payloads för samma plattform",
        "heading_size": "h2",
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-edp",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "enterprise-quote": {
      "type": "enterprise-quote-form",
      "settings": {
        "title": "Osäker på om den här payloaden passar ditt uppdrag?",
        "intro": "Beskriv din UAV-plattform och ditt uppdrag så återkommer vårt enterprise-team med kompatibilitetsbesked och offert inom 24 timmar.",
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "main",
    "payload-details",
    "related-products",
    "enterprise-quote"
  ]
}
