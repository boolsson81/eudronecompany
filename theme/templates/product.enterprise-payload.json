{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "compatibility": {
          "type": "text",
          "settings": {
            "text": "Kompatibilitetsstatus visas nedan under \"Kompatibla UAV-plattformar\".",
            "text_style": "uppercase"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Dela"
          }
        },
        "short": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign edc_short = product.metafields.seo.kort_text_150.value -%}{%- if edc_short != blank -%}<p class=\"product__text edc-short\">{{ edc_short | escape }}</p>{%- endif -%}"
          }
        },
        "payment": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-payment-icons' %}"
          }
        },
        "accordions": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-product-accordions' %}"
          }
        },
        "trust": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "check_mark",
            "heading_1": "Auktoriserad DJI Enterprise-partner",
            "icon_2": "check_mark",
            "heading_2": "Fakturaköp för företag",
            "icon_3": "check_mark",
            "heading_3": "Offert inom 24 timmar"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 10,
            "show_inventory_quantity": true
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "short",
        "caption",
        "compatibility",
        "price",
        "inventory",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust",
        "payment",
        "description",
        "accordions",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-edp",
        "media_size": "large",
        "constrain_to_viewport": true,
        "gallery_layout": "stacked",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "payload-details": {
      "type": "edp-payload-details",
      "settings": {
        "color_scheme": "scheme-edp",
        "quote_link": "/pages/contact-quote"
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Andra payloads för samma plattform",
        "heading_size": "h2",
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-edp",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "enterprise-quote": {
      "type": "enterprise-quote-form",
      "settings": {
        "title": "Osäker på om den här payloaden passar ditt uppdrag?",
        "intro": "Beskriv din UAV-plattform och ditt uppdrag så återkommer vårt enterprise-team med kompatibilitetsbesked och offert inom 24 timmar.",
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "faq": {
      "type": "edp-metafield-faq",
      "settings": {
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "sticky-atc": {
      "type": "edp-sticky-atc",
      "settings": {
        "color_scheme": "scheme-edp"
      }
    }
  },
  "order": [
    "main",
    "payload-details",
    "related-products",
    "enterprise-quote",
    "faq",
    "sticky-atc"
  ]
}
