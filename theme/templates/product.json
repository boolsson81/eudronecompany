{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "short": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign edc_short = product.metafields.seo.kort_text_150.value -%}{%- if edc_short != blank -%}<p class=\"product__text edc-short\">{{ edc_short | escape }}</p>{%- endif -%}"
          }
        },
        "payment": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-payment-icons' %}"
          }
        },
        "accordions": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-product-accordions' %}"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 10,
            "show_inventory_quantity": true
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "short",
        "caption",
        "price",
        "inventory",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "payment",
        "description",
        "accordions",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "product-relations": {
      "type": "edp-product-relations",
      "settings": {
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Du kanske också gillar",
        "heading_size": "h2",
        "columns_desktop": 4,
        "color_scheme": "scheme-edp",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "faq": {
      "type": "edp-metafield-faq",
      "settings": {
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "sticky-atc": {
      "type": "edp-sticky-atc",
      "settings": {
        "color_scheme": "scheme-edp"
      }
    }
  },
  "order": [
    "main",
    "product-relations",
    "related-products",
    "faq",
    "sticky-atc"
  ]
}
