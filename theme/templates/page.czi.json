        "row_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Vilka DJI-modeller passar CZI:s tillbehör?",
            "row_content": "<p>Sortimentet täcker bland annat M30, M300 RTK, M350 RTK, M400 och Mavic 3-serien — ange er modell så bekräftar vi exakt passform.</p>"
          }
        },
        "row_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Hur stor räckvidd har sökljusen?",
            "row_content": "<p>Räckvidden varierar mellan modellerna i GL- och LP-serien. Kontakta oss så matchar vi mot ert uppdrag.</p>"
          }
        },
        "row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Kan högtalarsystemet användas för myndighetsutrop?",
            "row_content": "<p>Ja, MP130-serien är byggd för luftburen utropskommunikation, ett vanligt användningsområde hos räddningstjänst och kommun.</p>"
          }
        },
        "row_4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Finns lastsläpp för nödutrustning?",
            "row_content": "<p>Ja, TH4-serien är ett lastsläppskit för DJI Matrice-plattformar.</p>"
          }
        }
      },
