{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "compatibility": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'product-compatibility' %}"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Dela"
          }
        },
        "short": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign edc_short = product.metafields.seo.kort_text_150.value -%}{%- if edc_short != blank -%}<p class=\"product__text edc-short\">{{ edc_short | escape }}</p>{%- endif -%}"
          }
        },
        "payment": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-payment-icons' %}"
          }
        },
        "accordions": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'edp-product-accordions' %}"
          }
        },
        "trust": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "check_mark",
            "heading_1": "Original reservdelar",
            "icon_2": "check_mark",
            "heading_2": "Skickas från lager inom 1–2 vardagar",
            "icon_3": "check_mark",
            "heading_3": "Full tillverkargaranti"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 10,
            "show_inventory_quantity": true
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "short",
        "caption",
        "compatibility",
        "price",
        "inventory",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust",
        "payment",
        "description",
        "accordions",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "trust-badges": {
      "type": "multicolumn",
      "blocks": {
        "column-0": {
          "type": "column",
          "settings": {
            "title": "Original reservdelar",
            "text": "<p>Vi säljer äkta reservdelar med full tillverkargaranti — aldrig kopior eller kompatibla efterlikningar.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column-1": {
          "type": "column",
          "settings": {
            "title": "Snabb leverans",
            "text": "<p>Skickas från lager inom 1–2 vardagar med spårbar frakt.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column-2": {
          "type": "column",
          "settings": {
            "title": "Kontrollera kompatibilitet",
            "text": "<p>Jämför din drönares modell mot listan ovan innan du beställer — hör av dig om du är osäker på vilken del du behöver.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "column-0",
        "column-1",
        "column-2"
      ],
      "settings": {
        "title": "",
        "heading_size": "h2",
        "image_width": "full",
        "image_ratio": "adapt",
        "columns_desktop": 3,
        "column_alignment": "left",
        "background_style": "none",
        "button_label": "",
        "button_link": "",
        "swipe_on_mobile": false,
        "color_scheme": "scheme-edp",
        "columns_mobile": "1",
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "product-relations": {
      "type": "edp-product-relations",
      "settings": {
        "accessories_heading": "Tillbehör till denna produkt",
        "spare_parts_heading": "Reservdelar",
        "docs_heading": "Dokumentation & manualer",
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "compatible-accessories": {
      "type": "compatible-accessories",
      "settings": {
        "accessories_collection_handle": "drone-accessories",
        "heading_size": "h2",
        "max_products": 8,
        "columns_desktop": 4,
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Fler reservdelar till din drönare",
        "heading_size": "h2",
        "columns_desktop": 4,
        "color_scheme": "scheme-edp",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "faq": {
      "type": "edp-metafield-faq",
      "settings": {
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "sticky-atc": {
      "type": "edp-sticky-atc",
      "settings": {
        "color_scheme": "scheme-edp"
      }
    }
  },
  "order": [
    "main",
    "trust-badges",
    "product-relations",
    "compatible-accessories",
    "related-products",
    "faq",
    "sticky-atc"
  ]
}
