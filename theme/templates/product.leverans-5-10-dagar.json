{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "sku": {
          "type": "sku",
          "settings": {
            "text_style": "body"
          }
        },
        "price": {
          "type": "price"
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 10,
            "show_inventory_quantity": true
          }
        },
        "short": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign edc_short = product.metafields.seo.kort_text_150.value -%}{%- if edc_short != blank -%}<p class=\"edc-short\">{{ edc_short | escape }}</p>{%- endif -%}"
          }
        },
        "compat": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n.edc-compat{border:1px solid rgba(var(--color-foreground),.15);border-radius:6px;padding:1.2rem 1.4rem;margin:1.2rem 0}\n.edc-compat__head{font-weight:700;margin:0 0 .6rem}\n.edc-compat__list{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.4rem 1.6rem}\n.edc-compat__list li::before{content:'\\2713';margin-right:.5rem}\n</style>\n{%- liquid\n  assign edc_list = product.metafields.custom.passsar_till.value\n  if edc_list == blank\n    assign edc_list = product.metafields.custom.passar_till_marke_modell.value\n  endif\n-%}\n{%- if edc_list != blank -%}\n<div class=\"edc-compat\"><p class=\"edc-compat__head\">✓ Kompatibel med</p><ul class=\"edc-compat__list\">{%- for item in edc_list -%}<li>{{ item | escape }}</li>{%- endfor -%}</ul></div>\n{%- endif -%}"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "rating": {
          "type": "rating"
        },
        "delivery": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>.edc-note{display:flex;align-items:center;gap:.8rem;margin:1rem 0 .4rem;font-weight:600}.edc-note svg{width:2.2rem;height:2.2rem;flex:none}</style>\n<div class=\"edc-note\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M1 6h13v10H1zM14 10h4l4 3v3h-8z\"/><circle cx=\"6\" cy=\"18\" r=\"2\"/><circle cx=\"18\" cy=\"18\" r=\"2\"/></svg><span>5-10 dagars leveranstid</span></div>"
          }
        },
        "payment": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>.edc-pay{margin:.6rem 0 1rem}.edc-pay h3{margin:0 0 .6rem}.edc-pay ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.6rem}</style>\n<div class=\"edc-pay\"><h3 class=\"h5\">Säker Betalning</h3><ul class=\"list-payment\" role=\"list\">{%- for type in shop.enabled_payment_types -%}<li class=\"list-payment__item\">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}</ul></div>"
          }
        },
        "usp": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "truck",
            "heading_1": "Fri frakt över 600 kr",
            "icon_2": "return",
            "heading_2": "Retur inom 14 dagar",
            "icon_3": "check_mark",
            "heading_3": "Säker betalning"
          }
        },
        "complementary": {
          "type": "complementary",
          "settings": {
            "block_heading": "Passar perfekt med",
            "icon": "price_tag",
            "product_list_limit": 6,
            "products_per_page": 3,
            "image_ratio": "square",
            "enable_quick_add": true
          }
        },
        "spec": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Specifikation",
            "icon": "ruler",
            "content": "",
            "page": ""
          }
        },
        "info": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"product__accordion accordion\"><details><summary><div class=\"summary__title\"><h2 class=\"h4 accordion__title\">Produkt information</h2></div>{{- 'icon-caret.svg' | inline_asset_content -}}</summary><div class=\"accordion__content rte\">{{ product.description }}</div></details></div>"
          }
        }
      },
      "block_order": [
        "title",
        "short",
        "vendor",
        "sku",
        "price",
        "inventory",
        "compat",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "rating",
        "delivery",
        "payment",
        "usp",
        "complementary",
        "spec",
        "info"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-edp",
        "media_size": "large",
        "constrain_to_viewport": false,
        "media_fit": "contain",
        "gallery_layout": "thumbnail_slider",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": false,
        "enable_video_looping": true,
        "padding_top": 20,
        "padding_bottom": 60
      }
    },
    "sticky-atc": {
      "type": "edp-sticky-atc",
      "settings": {
        "color_scheme": "scheme-edp"
      }
    }
  },
  "order": [
    "main",
    "sticky-atc"
  ]
}
