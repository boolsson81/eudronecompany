        {
          "type": "text",
          "id": "text",
          "label": "t:sections.enterprise-landing.blocks.benefit.settings.text.label",
          "default": "Fördel"
        }
      ]
    },
    {
      "type": "quote",
      "name": "t:sections.enterprise-landing.blocks.quote.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.enterprise-landing.blocks.quote.settings.title.label",
          "default": "Behöver du hjälp att välja rätt lösning?"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.enterprise-landing.blocks.quote.settings.text.label",
          "default": "Vårt enterprise-team hjälper dig med offert, projektering, utbildning och löpande support."
        },
        {
          "type": "text",
          "id": "button_label_1",
          "label": "t:sections.enterprise-landing.blocks.quote.settings.button_label_1.label",
          "default": "Skicka offertförfrågan"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "t:sections.enterprise-landing.blocks.quote.settings.button_link_1.label"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "t:sections.enterprise-landing.blocks.quote.settings.button_label_2.label",
          "default": "Ring oss"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "t:sections.enterprise-landing.blocks.quote.settings.button_link_2.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.enterprise-landing.presets.name",
      "blocks": [
        {
          "type": "hero",
          "settings": {
            "eyebrow": "Företag & organisationer",
            "title": "Drönarlösningar för professionella verksamheter",
            "text": "Vi hjälper företag, myndigheter och organisationer att välja, implementera och drifta UAV-lösningar — från Matrice och Dock till utbildning och support.",
            "button_label_1": "Begär offert",
            "button_link_1": "/pages/contact-quote",
            "button_label_2": "Boka rådgivning",
            "button_link_2": "/pages/contact-quote"
          }
        },
        {
          "type": "heading",
          "settings": {
            "group": "industries",
            "title": "Lösningar per bransch",
            "text": "Effektivisera arbetsflöden med drönarteknik anpassad för din sektor."
          }
        },
        {
          "type": "industry",
          "settings": {
            "title": "Energi & Infrastruktur",
            "text": "Inspektion av kraftledningar, vindkraft och anläggningar med termisk och visuell data.",
            "link_label": "Lösningar för energi",
            "link": "/pages/energi-infrastruktur"
          }
        },
        {
          "type": "industry",
          "settings": {
            "title": "Kartläggning & GIS",
