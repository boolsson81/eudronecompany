{% comment %}
  Payload categories overview — lists every collection whose handle starts
  with "payload-kategori-" (e.g. "Payload - Sök, räddning & belysning").
  Those are smart collections filtered on product metafield
  edp.payload_category, so a new "payload-kategori-<namn>" collection shows
  up here automatically. The older "Payload - <typ>" collections (filtered
  on custom.payload_type) are not listed.
{% endcomment %}
{{ 'edp-payload.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #shopify-section-{{ section.id }} .edp-payload__section-heading { font-size: 28px; margin: 0 0 20px; }
  #shopify-section-{{ section.id }} .edp-ptypes {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }
  #shopify-section-{{ section.id }} .edp-ptype { gap: 14px; padding: 28px; }
  #shopify-section-{{ section.id }} .edp-ptype__title { font-size: 22px; line-height: 1.25; font-weight: 600; margin: 0; }
  #shopify-section-{{ section.id }} .edp-ptype__media img { display: block; width: 100%; height: auto; border-radius: 4px; }
  #shopify-section-{{ section.id }} .edp-ptype__text { font-size: 16px; line-height: 1.55; margin: 0; color: var(--edp-payload-muted); }
  #shopify-section-{{ section.id }} .edp-ptype__inds { display: grid; gap: 10px; }
  #shopify-section-{{ section.id }} .edp-ptype__ind { margin: 0; font-size: 15px; line-height: 1.45; display: grid; gap: 2px; }
  #shopify-section-{{ section.id }} .edp-ptype__ind span { color: var(--edp-payload-muted); }
  #shopify-section-{{ section.id }} .edp-payload__pills { gap: 8px; }
  #shopify-section-{{ section.id }} .edp-payload__pill { font-size: 14px; line-height: 1.3; padding: 5px 12px; }
  #shopify-section-{{ section.id }} .edp-ptype__count { font-size: 14px; color: var(--edp-payload-muted); margin: 0; }
  #shopify-section-{{ section.id }} .edp-ptype__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  #shopify-section-{{ section.id }} .edp-ptype__item { display: flex; gap: 12px; align-items: center; color: inherit; text-decoration: none; font-size: 15px; line-height: 1.4; }
  #shopify-section-{{ section.id }} .edp-ptype__item:hover { text-decoration: underline; }
  #shopify-section-{{ section.id }} .edp-ptype__item img { width: 48px; height: 48px; object-fit: cover; border-radius: 4px; flex: none; }
  #shopify-section-{{ section.id }} .edp-ptype__more { margin-top: auto; padding-top: 6px; font-weight: 600; font-size: 16px; }
{%- endstyle -%}

<div class="edp-payload color-{{ section.settings.color_scheme }} gradient">
  <div class="edp-payload__wrap section-{{ section.id }}-padding">

    {%- if section.settings.heading != blank -%}
      <h2 class="edp-payload__section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- assign shown = 0 -%}
    <div class="edp-ptypes">
      {%- for c in collections -%}
        {%- assign prefix = c.handle | slice: 0, 17 -%}
        {%- if prefix == 'payload-kategori-' and c.products_count > 0 -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- assign type_name = c.title | remove_first: 'Payload -' | strip -%}
          <div class="edp-payload__card edp-ptype">
            {%- if c.image != blank -%}
              <div class="edp-ptype__media">
                {{ c.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600' }}
              </div>
            {%- endif -%}
            <h3 class="edp-ptype__title">{{ type_name | escape }}</h3>
            {%- if c.description != blank -%}
              <p class="edp-ptype__text">{{ c.description | strip_html | truncate: 180 }}</p>
            {%- endif -%}
            {%- if section.settings.show_industries -%}
              {%- assign ind_all = '' -%}
              {%- for product in c.products limit: 50 -%}
                {%- for ind in product.metafields.custom.bransch.value -%}
                  {%- if ind != blank -%}
                    {%- assign ind_all = ind_all | append: ind | append: '||' -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
              {%- assign ind_list = ind_all | split: '||' | uniq | sort -%}
              {%- if ind_list.size > 0 -%}
                {%- if section.settings.show_customer_types -%}
                  {%- assign customer_types = shop.metaobjects.customer_type.values -%}
                  <div class="edp-ptype__inds">
                    {%- for ind in ind_list -%}
                      {%- if ind != blank -%}
                        {%- assign ct_names = '' -%}
                        {%- for ct in customer_types -%}
                          {%- if ct.industry.value == ind -%}
                            {%- if ct_names != '' -%}{%- assign ct_names = ct_names | append: ', ' -%}{%- endif -%}
                            {%- assign ct_names = ct_names | append: ct.name.value -%}
                          {%- endif -%}
                        {%- endfor -%}
                        <p class="edp-ptype__ind"><strong>{{ ind | escape }}</strong>{%- if ct_names != '' -%}<span>{{ ct_names | escape }}</span>{%- endif -%}</p>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <ul class="edp-payload__pills">
                    {%- for ind in ind_list -%}
                      {%- if ind != blank -%}<li class="edp-payload__pill">{{ ind | escape }}</li>{%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
            {%- if section.settings.show_count -%}
              <p class="edp-ptype__count">{{ c.products_count }} produkter</p>
            {%- endif -%}

            {%- if section.settings.products_per_card > 0 -%}
              <ul class="edp-ptype__list">
                {%- for product in c.products limit: section.settings.products_per_card -%}
                  <li>
                    <a class="edp-ptype__item" href="{{ product.url }}">
                      {%- if product.featured_image != blank -%}
                        {{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', widths: '50,100' }}
                      {%- endif -%}
                      <span>{{ product.title | escape }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <a class="edp-ptype__more" href="{{ c.url }}">{{ section.settings.link_label | escape }} &rarr;</a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if shown == 0 and request.design_mode -%}
      <p class="edp-ptype__count">Inga publicerade kollektioner med adress som börjar på "payload-kategori-" och minst en produkt hittades.</p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Payload-typer",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Payloads efter typ" },
    { "type": "text", "id": "link_label", "label": "Länktext på korten", "default": "Visa alla" },
    { "type": "checkbox", "id": "show_count", "label": "Visa antal produkter", "default": true },
    { "type": "checkbox", "id": "show_industries", "label": "Visa branscher", "info": "Hämtas från produkternas metafält custom.bransch (de första 50 produkterna i varje typ).", "default": true },
    { "type": "checkbox", "id": "show_customer_types", "label": "Visa kundtyper under branscherna", "info": "Hämtas från metaobjekten Kundtyp, som hör till en bransch.", "default": true },
    { "type": "range", "id": "products_per_card", "min": 0, "max": 8, "step": 1, "label": "Produkter per kort", "info": "0 döljer produktlistan.", "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Färgschema", "default": "scheme-edp" },
    { "type": "header", "content": "Avstånd" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding topp", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding botten", "default": 36 }
  ],
  "presets": [{ "name": "Payload-typer" }]
}
{% endschema %}
