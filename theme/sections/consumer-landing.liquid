      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.consumer-landing.blocks.cta.settings.title.label",
          "default": "Redo att börja flyga?"
        },
        {
          "type": "textarea",
          "id": "text",
