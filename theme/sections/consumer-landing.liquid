{{ 'section-consumer-landing.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign hero_block = nil
  assign cta_block = nil
  assign categories_heading = nil
  assign features_heading = nil
  assign benefits_heading = nil

  for block in section.blocks
    case block.type
      when 'hero'
        if hero_block == nil
          assign hero_block = block
        endif
      when 'cta'
        if cta_block == nil
          assign cta_block = block
        endif
      when 'heading'
        if block.settings.group == 'categories' and categories_heading == nil
          assign categories_heading = block
        elsif block.settings.group == 'features' and features_heading == nil
          assign features_heading = block
        elsif block.settings.group == 'benefits' and benefits_heading == nil
          assign benefits_heading = block
        endif
    endcase
  endfor
-%}

<div class="consumer-landing color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding isolate">
    {%- if hero_block -%}
      <div
        class="consumer-landing__hero{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
        {{ hero_block.shopify_attributes }}
      >
        <div class="consumer-landing__hero-content">
          {%- unless hero_block.settings.eyebrow == blank -%}
            <p class="consumer-landing__eyebrow">{{ hero_block.settings.eyebrow | escape }}</p>
          {%- endunless -%}
          {%- unless hero_block.settings.title == blank -%}
            <h1 class="consumer-landing__hero-title {{ hero_block.settings.heading_size }}">
              {{ hero_block.settings.title | escape }}
            </h1>
          {%- endunless -%}
          {%- unless hero_block.settings.text == blank -%}
            <p class="consumer-landing__hero-text">{{ hero_block.settings.text | escape }}</p>
          {%- endunless -%}
          <div class="consumer-landing__hero-actions">
            {%- if hero_block.settings.button_label_1 != blank -%}
              <a
                href="{{ hero_block.settings.button_link_1 | default: '#' }}"
                class="consumer-landing__btn consumer-landing__btn--primary"
              >
                {{ hero_block.settings.button_label_1 | escape }}
              </a>
            {%- endif -%}
            {%- if hero_block.settings.button_label_2 != blank -%}
              <a
                href="{{ hero_block.settings.button_link_2 | default: '#' }}"
                class="consumer-landing__btn consumer-landing__btn--secondary"
              >
                {{ hero_block.settings.button_label_2 | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
        <div class="consumer-landing__hero-media">
          {%- if hero_block.settings.image != blank -%}
            {{
              hero_block.settings.image
              | image_url: width: 1200
              | image_tag:
                class: 'consumer-landing__hero-image',
                loading: 'eager',
                fetchpriority: 'high',
                widths: '550, 750, 1100, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: hero_block.settings.image.alt | default: hero_block.settings.title
            }}
          {%- else -%}
            <div class="consumer-landing__hero-placeholder" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="3"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
              </svg>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- assign category_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        {%- assign category_count = category_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if category_count > 0 -%}
      {%- if categories_heading -%}
        <div class="consumer-landing__subhead" {{ categories_heading.shopify_attributes }}>
          {%- unless categories_heading.settings.title == blank -%}
            <h2 class="consumer-landing__subhead-title {{ categories_heading.settings.heading_size }}">
              {{ categories_heading.settings.title | escape }}
            </h2>
          {%- endunless -%}
          {%- unless categories_heading.settings.text == blank -%}
            <p class="consumer-landing__subhead-text">{{ categories_heading.settings.text | escape }}</p>
          {%- endunless -%}
        </div>
      {%- endif -%}
      <ul class="consumer-landing__grid consumer-landing__grid--4" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            <li class="consumer-landing__card" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 160
                  | image_tag: class: 'consumer-landing__card-icon', loading: 'lazy', widths: '80, 120, 160', alt: block.settings.title
                }}
              {%- else -%}
                <div class="consumer-landing__card-icon-fallback" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="7" height="7" rx="1"/>
                    <rect x="14" y="3" width="7" height="7" rx="1"/>
                    <rect x="3" y="14" width="7" height="7" rx="1"/>
                    <rect x="14" y="14" width="7" height="7" rx="1"/>
                  </svg>
                </div>
              {%- endif -%}
              {%- unless block.settings.title == blank -%}
                <h3 class="consumer-landing__card-title">{{ block.settings.title | escape }}</h3>
              {%- endunless -%}
              {%- unless block.settings.text == blank -%}
                <p class="consumer-landing__card-text">{{ block.settings.text | escape }}</p>
              {%- endunless -%}
              {%- if block.settings.link_label != blank -%}
                <a class="consumer-landing__card-link" href="{{ block.settings.link | default: '#' }}">
                  {{ block.settings.link_label | escape }}
                </a>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- assign feature_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'feature' -%}
        {%- assign feature_count = feature_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if feature_count > 0 -%}
      {%- if features_heading -%}
        <div class="consumer-landing__subhead" {{ features_heading.shopify_attributes }}>
          {%- unless features_heading.settings.title == blank -%}
            <h2 class="consumer-landing__subhead-title {{ features_heading.settings.heading_size }}">
              {{ features_heading.settings.title | escape }}
            </h2>
          {%- endunless -%}
          {%- unless features_heading.settings.text == blank -%}
            <p class="consumer-landing__subhead-text">{{ features_heading.settings.text | escape }}</p>
          {%- endunless -%}
        </div>
      {%- endif -%}
      <ul class="consumer-landing__grid consumer-landing__grid--3" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <li class="consumer-landing__card" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 160
                  | image_tag: class: 'consumer-landing__card-icon', loading: 'lazy', widths: '80, 120, 160', alt: block.settings.title
                }}
              {%- else -%}
                <div class="consumer-landing__card-icon-fallback" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
              {%- endif -%}
              {%- unless block.settings.title == blank -%}
                <h3 class="consumer-landing__card-title">{{ block.settings.title | escape }}</h3>
              {%- endunless -%}
              {%- unless block.settings.text == blank -%}
                <p class="consumer-landing__card-text">{{ block.settings.text | escape }}</p>
              {%- endunless -%}
              {%- if block.settings.link_label != blank -%}
                <a class="consumer-landing__card-link" href="{{ block.settings.link | default: '#' }}">
                  {{ block.settings.link_label | escape }}
                </a>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- assign benefit_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'benefit' -%}
        {%- assign benefit_count = benefit_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if benefit_count > 0 -%}
      {%- if benefits_heading -%}
        <div class="consumer-landing__subhead" {{ benefits_heading.shopify_attributes }}>
          {%- unless benefits_heading.settings.title == blank -%}
            <h2 class="consumer-landing__subhead-title {{ benefits_heading.settings.heading_size }}">
              {{ benefits_heading.settings.title | escape }}
            </h2>
          {%- endunless -%}
        </div>
      {%- endif -%}
      <ul class="consumer-landing__benefits" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <li class="consumer-landing__benefit" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if cta_block -%}
      <div class="consumer-landing__cta" {{ cta_block.shopify_attributes }}>
        {%- unless cta_block.settings.title == blank -%}
          <h2 class="consumer-landing__cta-title h2">{{ cta_block.settings.title | escape }}</h2>
        {%- endunless -%}
        {%- unless cta_block.settings.text == blank -%}
          <p class="consumer-landing__cta-text">{{ cta_block.settings.text | escape }}</p>
        {%- endunless -%}
        <div class="consumer-landing__cta-actions">
          {%- if cta_block.settings.button_label_1 != blank -%}
            <a
              href="{{ cta_block.settings.button_link_1 | default: '/collections/consumer-drones' }}"
              class="consumer-landing__btn consumer-landing__btn--primary"
            >
              {{ cta_block.settings.button_label_1 | escape }}
            </a>
          {%- endif -%}
          {%- if cta_block.settings.button_label_2 != blank -%}
            <a
              href="{{ cta_block.settings.button_link_2 | default: '/collections/all' }}"
              class="consumer-landing__btn consumer-landing__btn--outline"
            >
              {{ cta_block.settings.button_label_2 | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.consumer-landing.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-edp"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "t:sections.consumer-landing.blocks.hero.name",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.consumer-landing.blocks.hero.settings.image.label"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:sections.consumer-landing.blocks.hero.settings.eyebrow.label",
          "default": "Konsumentdrönare"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.consumer-landing.blocks.hero.settings.title.label",
          "default": "Drönare för foto, video och äventyr"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
            { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
            { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.consumer-landing.blocks.hero.settings.text.label",
          "default": "Utforska DJI Mini, Air och Mavic — plus tillbehör, reservdelar och kom igång-paket för privat bruk."
        },
        {
          "type": "text",
          "id": "button_label_1",
          "label": "t:sections.consumer-landing.blocks.hero.settings.button_label_1.label",
          "default": "Handla drönare"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "t:sections.consumer-landing.blocks.hero.settings.button_link_1.label"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "t:sections.consumer-landing.blocks.hero.settings.button_label_2.label",
          "default": "Se kom igång-paket"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "t:sections.consumer-landing.blocks.hero.settings.button_link_2.label"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.consumer-landing.blocks.heading.name",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "group",
          "label": "t:sections.consumer-landing.blocks.heading.settings.group.label",
          "options": [
            { "value": "categories", "label": "t:sections.consumer-landing.blocks.heading.settings.group.options__1.label" },
            { "value": "features", "label": "t:sections.consumer-landing.blocks.heading.settings.group.options__2.label" },
            { "value": "benefits", "label": "t:sections.consumer-landing.blocks.heading.settings.group.options__3.label" }
          ],
          "default": "categories"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.consumer-landing.blocks.heading.settings.title.label",
          "default": "Rubrik"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
            { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" }
          ],
          "default": "h2",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.consumer-landing.blocks.heading.settings.text.label"
        }
      ]
    },
    {
      "type": "category",
      "name": "t:sections.consumer-landing.blocks.category.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.consumer-landing.blocks.category.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.consumer-landing.blocks.category.settings.title.label",
          "default": "Kategori"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.consumer-landing.blocks.category.settings.text.label",
          "default": "Kort beskrivning av kategorin."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.consumer-landing.blocks.category.settings.link_label.label",
          "default": "Utforska"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.consumer-landing.blocks.category.settings.link.label"
        }
      ]
    },
    {
      "type": "feature",
