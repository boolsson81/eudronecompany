          "default": "Hitta rätt drönare, tillbehör och utbildning — allt på ett ställe."
        },
        {
          "type": "text",
          "id": "button_label_1",
          "label": "t:sections.consumer-landing.blocks.cta.settings.button_label_1.label",
          "default": "Handla alla drönare"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "t:sections.consumer-landing.blocks.cta.settings.button_link_1.label"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "t:sections.consumer-landing.blocks.cta.settings.button_label_2.label",
          "default": "Se tillbehör"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "t:sections.consumer-landing.blocks.cta.settings.button_link_2.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.consumer-landing.presets.name",
      "blocks": [
        {
          "type": "hero",
          "settings": {
            "eyebrow": "Konsumentdrönare",
            "title": "Drönare för foto, video och äventyr",
            "text": "Utforska DJI Mini, Air och Mavic — plus tillbehör, reservdelar och kom igång-paket för privat bruk.",
