{{ 'edp-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'edp-countdown.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="edp-countdown color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding edp-countdown__inner">
    {%- unless section.settings.heading == blank -%}
      <h2 class="edp-countdown__heading h2">{{ section.settings.heading | escape }}</h2>
    {%- endunless -%}
    {%- unless section.settings.text == blank -%}
      <p class="edp-countdown__text">{{ section.settings.text | escape }}</p>
    {%- endunless -%}

    <edp-countdown
      class="edp-countdown__timer"
      data-target="{{ section.settings.target_date | escape }}"
    >
      <div class="edp-countdown__unit"><span class="edp-countdown__number" data-days>00</span><span class="edp-countdown__label">{{ 'edp.countdown.days' | t }}</span></div>
      <div class="edp-countdown__unit"><span class="edp-countdown__number" data-hours>00</span><span class="edp-countdown__label">{{ 'edp.countdown.hours' | t }}</span></div>
      <div class="edp-countdown__unit"><span class="edp-countdown__number" data-minutes>00</span><span class="edp-countdown__label">{{ 'edp.countdown.minutes' | t }}</span></div>
      <div class="edp-countdown__unit"><span class="edp-countdown__number" data-seconds>00</span><span class="edp-countdown__label">{{ 'edp.countdown.seconds' | t }}</span></div>
    </edp-countdown>

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button edp-countdown__button">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.edp-countdown-timer.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.edp-countdown-timer.settings.heading.label",
      "default": "Kampanjen slutar om"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.edp-countdown-timer.settings.text.label"
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "t:sections.edp-countdown-timer.settings.target_date.label",
      "info": "t:sections.edp-countdown-timer.settings.target_date.info",
      "default": "2026-12-24T00:00:00"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.edp-countdown-timer.settings.button_label.label"
    },
    { "type": "url", "id": "button_link", "label": "t:sections.edp-countdown-timer.settings.button_link.label" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-edp"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "presets": [{ "name": "t:sections.edp-countdown-timer.presets.name" }]
}
{% endschema %}
