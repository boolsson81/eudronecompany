{{ 'edp-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="edp-home-portals color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank and section.settings.text == blank -%}
      <div class="edp-home-portals__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {%- unless section.settings.heading == blank -%}
          <h2 class="edp-home-portals__heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endunless -%}
        {%- unless section.settings.text == blank -%}
          <p class="edp-home-portals__text">{{ section.settings.text | escape }}</p>
        {%- endunless -%}
      </div>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="edp-home-portals__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="edp-home-portals__card" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="edp-home-portals__card-link">
              {%- if block.settings.image != blank -%}
                <span class="edp-home-portals__icon edp-home-portals__icon--image">
                  {{
                    block.settings.image
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', widths: '80,120,160', alt: block.settings.title
                  }}
                </span>
              {%- else -%}
                <span class="edp-home-portals__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'education' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M22 10L12 5 2 10l10 5 10-5z"/>
                        <path d="M6 12v5c0 1.5 2.5 3 6 3s6-1.5 6-3v-5"/>
                      </svg>
                    {%- else -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M4 13a8 8 0 0 1 16 0v4"/>
                        <rect x="2" y="13" width="4" height="6" rx="1.5"/>
                        <rect x="18" y="13" width="4" height="6" rx="1.5"/>
                        <path d="M20 19a3 3 0 0 1-3 3h-2"/>
                      </svg>
                  {%- endcase -%}
                </span>
              {%- endif -%}
              <span class="edp-home-portals__body">
                {%- unless block.settings.title == blank -%}
                  <span class="edp-home-portals__title">{{ block.settings.title | escape }}</span>
                {%- endunless -%}
                {%- unless block.settings.text == blank -%}
                  <span class="edp-home-portals__card-text">{{ block.settings.text | escape }}</span>
                {%- endunless -%}
                {%- unless block.settings.link_label == blank -%}
                  <span class="edp-home-portals__cta">{{ block.settings.link_label | escape }}</span>
                {%- endunless -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.edp-home-portals.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.edp-home-portals.settings.heading.label",
      "default": "Kundportaler"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.edp-home-portals.settings.text.label",
      "default": "Redan kund? Logga in för att hantera ärenden eller din utbildning."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-edp"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "portal",
      "name": "t:sections.edp-home-portals.blocks.portal.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.edp-home-portals.blocks.portal.settings.icon.label",
          "options": [
            { "value": "service", "label": "t:sections.edp-home-portals.blocks.portal.settings.icon.options__1.label" },
            { "value": "education", "label": "t:sections.edp-home-portals.blocks.portal.settings.icon.options__2.label" }
          ],
          "default": "service"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.edp-home-portals.blocks.portal.settings.image.label",
          "info": "t:sections.edp-home-portals.blocks.portal.settings.image.info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.edp-home-portals.blocks.portal.settings.title.label",
          "default": "Serviceportal"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.edp-home-portals.blocks.portal.settings.text.label",
          "default": "Kort beskrivning av portalen."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.edp-home-portals.blocks.portal.settings.link_label.label",
          "default": "Logga in"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.edp-home-portals.blocks.portal.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.edp-home-portals.presets.name",
      "blocks": [
        {
          "type": "portal",
          "settings": {
            "icon": "service",
            "title": "Serviceportal",
            "text": "Spåra serviceärenden, reservdelsbeställningar och garantier.",
            "link_label": "Logga in på serviceportalen"
          }
        },
        {
          "type": "portal",
          "settings": {
            "icon": "education",
            "title": "Utbildningsportal",
            "text": "Boka drönarkurser, håll koll på certifieringar och kursintyg.",
            "link_label": "Logga in på utbildningsportalen"
          }
        }
      ]
    }
  ]
}
{% endschema %}
