{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .section-divider__line {
    width: {{ section.settings.line_width }}%;
    border: none;
    border-top-style: {{ section.settings.line_style }};
    border-top-width: {{ section.settings.line_thickness }}px;
    border-top-color: currentColor;
    margin: 0 auto;
    opacity: {{ section.settings.line_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding page-width">
    {%- if section.settings.line_style != 'none' -%}
      <hr class="section-divider__line">
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.section-divider.name",
  "tag": "section",
  "class": "section section--divider",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "t:sections.section-divider.settings.line_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.section-divider.settings.line_style.options__1.label"
        },
        {
          "value": "solid",
          "label": "t:sections.section-divider.settings.line_style.options__2.label"
        },
        {
          "value": "dashed",
          "label": "t:sections.section-divider.settings.line_style.options__3.label"
        },
        {
          "value": "dotted",
          "label": "t:sections.section-divider.settings.line_style.options__4.label"
        }
      ],
      "default": "solid"
    },
    {
      "type": "range",
      "id": "line_width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.section-divider.settings.line_width.label",
      "default": 100
    },
    {
      "type": "range",
      "id": "line_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "t:sections.section-divider.settings.line_thickness.label",
      "default": 1
    },
    {
      "type": "range",
      "id": "line_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.section-divider.settings.line_opacity.label",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "t:sections.section-divider.presets.name"
    }
  ]
}
{% endschema %}
