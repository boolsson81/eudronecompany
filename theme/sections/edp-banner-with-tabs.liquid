{{ 'edp-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- for block in section.blocks -%}
    #EdpTab-{{ block.id }}:checked ~ .edp-tabs__body .edp-tabs__panel[data-panel="{{ block.id }}"] {
      display: grid;
    }
    #EdpTab-{{ block.id }}:checked ~ .edp-tabs__nav label[for="EdpTab-{{ block.id }}"] {
      background: rgb(var(--edp-accent, 0, 163, 224));
      border-color: rgb(var(--edp-accent, 0, 163, 224));
      color: #fff;
    }
  {%- endfor -%}
{%- endstyle -%}

<div class="edp-tabs-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank -%}
      <h2 class="edp-tabs-section__heading h2">{{ section.settings.heading | escape }}</h2>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      <div class="edp-tabs">
        {%- for block in section.blocks -%}
          <input
            type="radio"
            name="edp-tabs-{{ section.id }}"
            id="EdpTab-{{ block.id }}"
            class="edp-tabs__radio"
            {% if forloop.first %}checked{% endif %}
          >
        {%- endfor -%}

        <div class="edp-tabs__nav" role="tablist">
          {%- for block in section.blocks -%}
            <label for="EdpTab-{{ block.id }}" class="edp-tabs__nav-item" {{ block.shopify_attributes }}>
              {{ block.settings.tab_label | escape }}
            </label>
          {%- endfor -%}
        </div>

        <div class="edp-tabs__body">
          {%- for block in section.blocks -%}
            <div class="edp-tabs__panel" data-panel="{{ block.id }}">
              <div class="edp-tabs__panel-media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag: loading: 'lazy', widths: '400,600,900,1200', alt: block.settings.heading
                  }}
                {%- endif -%}
              </div>
              <div class="edp-tabs__panel-content">
                {%- unless block.settings.eyebrow == blank -%}
                  <span class="edp-tabs__panel-eyebrow">{{ block.settings.eyebrow | escape }}</span>
                {%- endunless -%}
                {%- unless block.settings.heading == blank -%}
                  <h3 class="edp-tabs__panel-heading">{{ block.settings.heading | escape }}</h3>
                {%- endunless -%}
                {%- unless block.settings.text == blank -%}
                  <p class="edp-tabs__panel-text">{{ block.settings.text | escape }}</p>
                {%- endunless -%}
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link | default: '#' }}" class="button">
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.edp-banner-with-tabs.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 5,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.edp-banner-with-tabs.settings.heading.label",
      "default": "Utforska efter användning"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-edp"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:sections.edp-banner-with-tabs.blocks.tab.name",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "t:sections.edp-banner-with-tabs.blocks.tab.settings.tab_label.label", "default": "Flik" },
        { "type": "image_picker", "id": "image", "label": "t:sections.edp-banner-with-tabs.blocks.tab.settings.image.label" },
        { "type": "text", "id": "eyebrow", "label": "t:sections.edp-banner-with-tabs.blocks.tab.settings.eyebrow.label" },
        { "type": "text", "id": "heading", "label": "t:sections.edp-banner-with-tabs.blocks.tab.settings.heading.label", "default": "Rubrik" },
        { "type": "textarea", "id": "text", "label": "t:sections.edp-banner-with-tabs.blocks.tab.settings.text.label" },
        { "type": "text", "id": "button_label", "label": "t:sections.edp-banner-with-tabs.blocks.tab.settings.button_label.label" },
        { "type": "url", "id": "button_link", "label": "t:sections.edp-banner-with-tabs.blocks.tab.settings.button_link.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.edp-banner-with-tabs.presets.name",
      "blocks": [
        { "type": "tab", "settings": { "tab_label": "Konsument", "eyebrow": "Privat", "heading": "Fritidsflygning", "text": "DJI Mini & Air, tillbehör och kom igång-paket." } },
        { "type": "tab", "settings": { "tab_label": "Tävling & FPV", "eyebrow": "Racing", "heading": "Freestyle & tävling", "text": "FPV-utrustning, racingdelar och simulator." } },
        { "type": "tab", "settings": { "tab_label": "Enterprise", "eyebrow": "Företag", "heading": "Professionella UAV-lösningar", "text": "Matrice, Dock och branschpaket." } }
      ]
    }
  ]
}
{% endschema %}
