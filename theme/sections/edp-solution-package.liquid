{% comment %}
  Solution package page — Shopify-native metaobject template for
  `solution_package` (onlineStore urlHandle: "solutions").
{% endcomment %}
{{ 'edp-payload.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign pkg = closest.metaobject
  assign quote_link = section.settings.quote_link | default: '/pages/contact-quote'
-%}

{%- if pkg == blank -%}
  <div class="edp-payload__wrap edp-payload__section">
    <p>Det här paketet kunde inte hittas.</p>
  </div>
{%- else -%}
  <div class="edp-payload color-{{ section.settings.color_scheme }}">
    <div class="edp-payload__wrap">

      <nav class="edp-payload__breadcrumb" aria-label="Brödsmula">
        <a href="/">Hem</a>
        <span aria-hidden="true">/</span>
        <a href="/pages/enterprise">Enterprise</a>
        {%- if pkg.mission.value != blank -%}
          <span aria-hidden="true">/</span>
          <a href="{{ pkg.mission.value.url }}">{{ pkg.mission.value.name.value | escape }}</a>
        {%- endif -%}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ pkg.name.value | escape }}</span>
      </nav>

      <header class="edp-payload__hero">
        <p class="edp-payload__eyebrow">Lösningspaket</p>
        <h1 class="edp-payload__title">{{ pkg.name.value | escape }}</h1>
        {%- if pkg.description.value != blank -%}
          <div class="edp-payload__lede">{{ pkg.description.value }}</div>
        {%- endif -%}
        <div class="edp-cta-row">
          <a href="{{ quote_link }}" class="button">Begär Enterprise-offert</a>
        </div>
      </header>

      {%- if pkg.components_summary.value != blank -%}
        <section class="edp-payload__section">
          <h2 class="edp-payload__section-heading">Vad ingår</h2>
          <ul class="edp-payload__pills">
            {%- for c in pkg.components_summary.value -%}<li class="edp-payload__pill">{{ c | escape }}</li>{%- endfor -%}
          </ul>
        </section>
      {%- endif -%}

      {%- assign has_products = false -%}
      {%- if pkg.uav_products.value != blank or pkg.payload_products.value != blank or pkg.accessory_products.value != blank or pkg.software_products.value != blank or pkg.training_products.value != blank or pkg.service_products.value != blank -%}
        {%- assign has_products = true -%}
      {%- endif -%}
      {%- if has_products -%}
        <section class="edp-payload__section">
          <h2 class="edp-payload__section-heading">Produkter i paketet</h2>
          <div class="edp-payload__grid">
            {%- for product in pkg.uav_products.value -%}{%- render 'card-product', card_product: product, media_aspect_ratio: 'square' -%}{%- endfor -%}
            {%- for product in pkg.payload_products.value -%}{%- render 'card-product', card_product: product, media_aspect_ratio: 'square' -%}{%- endfor -%}
            {%- for product in pkg.accessory_products.value -%}{%- render 'card-product', card_product: product, media_aspect_ratio: 'square' -%}{%- endfor -%}
            {%- for product in pkg.software_products.value -%}{%- render 'card-product', card_product: product, media_aspect_ratio: 'square' -%}{%- endfor -%}
            {%- for product in pkg.training_products.value -%}{%- render 'card-product', card_product: product, media_aspect_ratio: 'square' -%}{%- endfor -%}
            {%- for product in pkg.service_products.value -%}{%- render 'card-product', card_product: product, media_aspect_ratio: 'square' -%}{%- endfor -%}
          </div>
        </section>
      {%- else -%}
        <section class="edp-payload__section">
          <p class="edp-payload__prose edp-payload__spec-not-specified">
            De specifika produkterna i det här paketet är inte kopplade ännu. Kontakta vårt enterprise-team för en konfiguration anpassad efter din flotta.
          </p>
        </section>
      {%- endif -%}

      {%- if pkg.estimated_price_note.value != blank -%}
        <section class="edp-payload__section">
          <h2 class="edp-payload__section-heading">Pris</h2>
          <p class="edp-payload__prose">{{ pkg.estimated_price_note.value | escape }}</p>
        </section>
      {%- endif -%}

      <section class="edp-payload__banner">
        <h2 class="edp-payload__banner-title">Vill du ha {{ pkg.name.value | downcase }} anpassat efter din flotta?</h2>
        <div class="edp-cta-row">
          <a href="{{ quote_link }}" class="button">Begär Enterprise-offert</a>
          {%- if pkg.mission.value != blank -%}
            <a href="{{ pkg.mission.value.url }}" class="button button--secondary">Läs om uppdraget</a>
          {%- endif -%}
        </div>
      </section>

    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Lösningspaket",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Färgschema", "default": "scheme-edp" },
    { "type": "url", "id": "quote_link", "label": "Länk till offertformulär", "default": "/pages/contact-quote" }
  ],
  "presets": [{ "name": "Lösningspaket" }]
}
{% endschema %}
