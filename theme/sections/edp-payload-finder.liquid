{% comment %}
  Payload Finder — 5-step guide that recommends payload_category entries
  based on task, industry, environment, sensor technology and UAV platform.

  Self-contained (assets/edp-payload.css + assets/edp-payload-finder.js),
  no theme framework dependency (see Phase 1 audit: live theme is Horizon,
  repo theme is Dawn). All wizard vocabulary (tasks/industries/environments/
  technologies) and the weighted scoring model come from
  data/edp-payload-taxonomy.json's `finder` block, duplicated here as fixed
  UI copy — it's wizard configuration, not product/business data, so it does
  not belong in a metaobject.

  Scoring model (see docs/reports/ENTERPRISE_PAYLOAD_PHASE3_REPORT.md and
  the inline comments in edp-payload-finder.js for the full rationale):
  Compatibility 30% / Mission 25% / Sensor 20% / Environment 10% /
  Technical performance 10% / Customer requirements 5%. Compatibility,
  performance and requirements can't be computed from category-level data
  today (no per-platform compatibility or product specs exist yet at this
  level), so those dimensions use an explicit neutral baseline rather than
  a fabricated confident score — the UI always discloses this and never
  claims a confirmed compatibility.
{% endcomment %}
{{ 'edp-payload.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign quote_link = section.settings.quote_link | default: '/pages/contact-quote'
  assign categories = shop.metaobjects.payload_category.values
  assign missions = shop.metaobjects.mission.values
  assign platforms = shop.metaobjects.uav_platform.values
-%}

<div class="edp-payload color-{{ section.settings.color_scheme }}">
  <div class="edp-payload__wrap">

    <header class="edp-payload__hero edp-payload__hero--finder">
      <p class="edp-payload__eyebrow">Payload Finder</p>
      <h1 class="edp-payload__title">{{ section.settings.heading | default: 'Hitta rätt payload' }}</h1>
      <p class="edp-payload__lede">{{ section.settings.intro | default: 'Svara på fem korta frågor så föreslår vi vilka payload-kategorier som passar ditt uppdrag bäst. Resultatet är en vägledning — vårt enterprise-team bekräftar alltid slutgiltig kompatibilitet och pris.' }}</p>
    </header>

    <div id="edp-finder-root" class="edp-finder" data-quote-link="{{ quote_link | escape }}">
      <noscript>
        <p class="edp-payload__prose">Payload Finder kräver JavaScript. <a href="{{ quote_link }}">Kontakta vårt enterprise-team</a> direkt så hjälper vi dig hitta rätt payload.</p>
      </noscript>
    </div>

    <script type="application/json" id="edp-finder-data">
      {
        "vocab": {
          "tasks": [
            {"key":"inspect","label":"Inspektera"},
            {"key":"survey","label":"Mäta"},
            {"key":"map","label":"Kartlägga"},
            {"key":"measure-temperature","label":"Mäta temperatur"},
            {"key":"detect-gas","label":"Detektera gas"},
            {"key":"search","label":"Söka"},
            {"key":"monitor","label":"Övervaka"},
            {"key":"scan","label":"Skanna"},
            {"key":"detect-vegetation","label":"Analysera vegetation"},
            {"key":"measure-terrain","label":"Mäta terräng"},
            {"key":"identify-materials","label":"Identifiera material"}
          ],
          "industries": [
            {"key":"energy","label":"Energi"},
            {"key":"construction","label":"Bygg"},
            {"key":"public-safety","label":"Samhällssäkerhet"},
            {"key":"forestry","label":"Skogsbruk"},
            {"key":"agriculture","label":"Jordbruk"},
            {"key":"infrastructure","label":"Infrastruktur"},
            {"key":"industrial","label":"Industri"},
            {"key":"mining","label":"Gruva"},
            {"key":"security","label":"Säkerhet"},
            {"key":"maritime","label":"Maritimt"},
            {"key":"research","label":"Forskning"}
          ],
          "environments": [
            {"key":"day","label":"Dag"},
            {"key":"night","label":"Natt"},
            {"key":"smoke","label":"Rök"},
            {"key":"low-light","label":"Svagt ljus"},
            {"key":"indoor","label":"Inomhus"},
            {"key":"outdoor","label":"Utomhus"},
            {"key":"long-distance","label":"Långt avstånd"},
            {"key":"difficult-terrain","label":"Svår terräng"}
          ],
          "technologies": [
            {"key":"rgb","label":"RGB"},
            {"key":"zoom","label":"Zoom"},
            {"key":"thermal","label":"Termisk"},
            {"key":"eo-ir","label":"EO/IR"},
            {"key":"lidar","label":"LiDAR"},
            {"key":"multispectral","label":"Multispektralt"},
            {"key":"hyperspectral","label":"Hyperspektralt"},
            {"key":"gas","label":"Gas"},
            {"key":"radiation","label":"Strålning"},
            {"key":"spotlight","label":"Sökljus"},
            {"key":"speaker","label":"Högtalare"},
            {"key":"mapping","label":"Kartläggning"},
            {"key":"other","label":"Annat"}
          ]
        },
        "scoring_weights": { "compatibility": 30, "mission": 25, "sensor": 20, "environment": 10, "performance": 10, "requirements": 5 },
        "score_bands": [
          { "min": 90, "label": "Utmärkt matchning" },
          { "min": 75, "label": "Stark matchning" },
          { "min": 60, "label": "Möjlig matchning" },
          { "min": 0, "label": "Kräver bekräftelse" }
        ],
        "categories": [
          {%- for category in categories -%}
            {
              "handle": {{ category.handle | json }},
              "name": {{ category.name.value | json }},
              "technology": {{ category.technology.value | json }},
              "short_description": {{ category.short_description.value | json }},
              "url": {{ category.url | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "missions": [
          {%- for mission in missions -%}
            {
              "handle": {{ mission.handle | json }},
              "name": {{ mission.name.value | json }},
              "industry": {{ mission.industry.value | json }},
              "tasks": {{ mission.tasks.value | json }},
              "technologies": {{ mission.technologies.value | json }},
              "environments": {{ mission.environments.value | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "platforms": [
          {%- for platform in platforms -%}
            {
              "handle": {{ platform.handle | json }},
              "name": {{ platform.name.value | json }},
              "manufacturer": {{ platform.manufacturer.value | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>

  </div>
</div>

<script src="{{ 'edp-payload-finder.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Payload Finder",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Färgschema", "default": "scheme-edp" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Hitta rätt payload" },
    { "type": "textarea", "id": "intro", "label": "Ingress" },
    { "type": "url", "id": "quote_link", "label": "Länk till offertformulär", "default": "/pages/contact-quote" }
  ],
  "presets": [{ "name": "Payload Finder" }]
}
{% endschema %}
