{% comment %}
  Renders curated product relationships and documentation already stored on the product
  via existing (but previously unused-in-theme) metafields:
    - custom.dronartillbehor  (list.product_reference) -> "Tillbehör till denna produkt"
    - custom.reservdelar      (list.product_reference) -> "Reservdelar"
    - custom.manual           (list.file_reference)     -> "Dokumentation & manualer"
    - custom.pdf              (file_reference)           -> "Dokumentation & manualer"
  Each block only renders when the underlying metafield has a value, so the section is a
  no-op on products where the merchant hasn't filled these fields in yet.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- assign edp_accessories = product.metafields.custom.dronartillbehor.value -%}
{%- assign edp_spare_parts = product.metafields.custom.reservdelar.value -%}
{%- assign edp_manuals = product.metafields.custom.manual.value -%}
{%- assign edp_pdf = product.metafields.custom.pdf.value -%}

{%- assign edp_has_docs = false -%}
{%- if edp_manuals != blank or edp_pdf != blank -%}
  {%- assign edp_has_docs = true -%}
{%- endif -%}

{%- if edp_accessories != blank or edp_spare_parts != blank or edp_has_docs -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="edp-product-relations page-width section-{{ section.id }}-padding">
      {%- if edp_accessories != blank -%}
        <div class="edp-product-relations__group">
          <h2 class="edp-product-relations__heading inline-richtext h2">{{ section.settings.accessories_heading }}</h2>
          <ul class="grid product-grid grid--4-col-desktop grid--2-col-tablet-down" role="list">
            {%- assign edp_skip_styles = false -%}
            {%- for accessory in edp_accessories limit: 8 -%}
              <li class="grid__item">
                {% render 'card-product', card_product: accessory, media_aspect_ratio: 'square', show_vendor: false, skip_styles: edp_skip_styles %}
              </li>
              {%- assign edp_skip_styles = true -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if edp_spare_parts != blank -%}
        <div class="edp-product-relations__group">
          <h2 class="edp-product-relations__heading inline-richtext h2">{{ section.settings.spare_parts_heading }}</h2>
          <ul class="grid product-grid grid--4-col-desktop grid--2-col-tablet-down" role="list">
            {%- assign edp_skip_styles = false -%}
            {%- for part in edp_spare_parts limit: 8 -%}
              <li class="grid__item">
                {% render 'card-product', card_product: part, media_aspect_ratio: 'square', show_vendor: false, skip_styles: edp_skip_styles %}
              </li>
              {%- assign edp_skip_styles = true -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if edp_has_docs -%}
        <div class="edp-product-relations__group">
          <h2 class="edp-product-relations__heading inline-richtext h2">{{ section.settings.docs_heading }}</h2>
          <ul class="edp-product-relations__docs" role="list">
            {%- if edp_pdf != blank -%}
              <li>
                <a href="{{ edp_pdf.url }}" class="link" target="_blank" rel="noopener">
                  {{ edp_pdf.alt | default: edp_pdf.filename | default: 'PDF' }}
                </a>
              </li>
            {%- endif -%}
            {%- for doc in edp_manuals -%}
              <li>
                <a href="{{ doc.url }}" class="link" target="_blank" rel="noopener">
                  {{ doc.alt | default: doc.filename | default: 'Manual' }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .edp-product-relations__group {
    margin-bottom: 3rem;
  }

  .edp-product-relations__group:last-child {
    margin-bottom: 0;
  }

  .edp-product-relations__heading {
    margin-bottom: 1.5rem;
  }

  .edp-product-relations__docs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Produktrelationer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "accessories_heading",
      "label": "Rubrik – tillbehör",
      "default": "Tillbehör till denna produkt"
    },
    {
      "type": "text",
      "id": "spare_parts_heading",
      "label": "Rubrik – reservdelar",
      "default": "Reservdelar"
    },
    {
      "type": "text",
      "id": "docs_heading",
      "label": "Rubrik – dokumentation",
      "default": "Dokumentation & manualer"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-edp"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Produktrelationer"
    }
  ]
}
{% endschema %}
