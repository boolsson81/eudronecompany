{{ 'edp-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="edp-image-comparison-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank and section.settings.text == blank -%}
      <div class="edp-image-comparison-section__header">
        {%- unless section.settings.heading == blank -%}
          <h2 class="edp-image-comparison-section__heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endunless -%}
        {%- unless section.settings.text == blank -%}
          <p class="edp-image-comparison-section__text">{{ section.settings.text | escape }}</p>
        {%- endunless -%}
      </div>
    {%- endunless -%}

    {%- if section.settings.image_before != blank and section.settings.image_after != blank -%}
      <div class="edp-image-comparison" style="--edp-ic-position: 50%;">
        <div class="edp-image-comparison__figure">
          {{
            section.settings.image_after
            | image_url: width: 1600
            | image_tag: class: 'edp-image-comparison__image edp-image-comparison__image--after', loading: 'lazy', widths: '400,600,900,1200,1600', alt: section.settings.after_label
          }}
          {{
            section.settings.image_before
            | image_url: width: 1600
            | image_tag: class: 'edp-image-comparison__image edp-image-comparison__image--before', loading: 'lazy', widths: '400,600,900,1200,1600', alt: section.settings.before_label
          }}
          <div class="edp-image-comparison__divider" aria-hidden="true">
            <span class="edp-image-comparison__handle">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 5l-6 7 6 7M16 5l6 7-6 7"/></svg>
            </span>
          </div>
          {%- unless section.settings.before_label == blank -%}
            <span class="edp-image-comparison__label edp-image-comparison__label--before">{{ section.settings.before_label | escape }}</span>
          {%- endunless -%}
          {%- unless section.settings.after_label == blank -%}
            <span class="edp-image-comparison__label edp-image-comparison__label--after">{{ section.settings.after_label | escape }}</span>
          {%- endunless -%}
        </div>
        <input
          type="range"
          class="edp-image-comparison__range"
          min="0"
          max="100"
          value="50"
          aria-label="{{ 'edp.image_comparison.slider_label' | t }}"
          oninput="this.closest('.edp-image-comparison').style.setProperty('--edp-ic-position', this.value + '%')"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.edp-image-comparison.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.edp-image-comparison.settings.heading.label",
      "default": "Före & efter"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.edp-image-comparison.settings.text.label"
    },
    { "type": "image_picker", "id": "image_before", "label": "t:sections.edp-image-comparison.settings.image_before.label" },
    { "type": "text", "id": "before_label", "label": "t:sections.edp-image-comparison.settings.before_label.label", "default": "Före" },
    { "type": "image_picker", "id": "image_after", "label": "t:sections.edp-image-comparison.settings.image_after.label" },
    { "type": "text", "id": "after_label", "label": "t:sections.edp-image-comparison.settings.after_label.label", "default": "Efter" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-edp"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "presets": [{ "name": "t:sections.edp-image-comparison.presets.name" }]
}
{% endschema %}
