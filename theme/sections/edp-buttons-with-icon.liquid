{{ 'edp-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="edp-buttons-with-icon color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank -%}
      <h2 class="edp-buttons-with-icon__heading h2">{{ section.settings.heading | escape }}</h2>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="edp-buttons-with-icon__list" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="edp-buttons-with-icon__pill">
              <span class="edp-buttons-with-icon__icon" aria-hidden="true">
                {%- render 'edp-icon', icon: block.settings.icon -%}
              </span>
              {{ block.settings.label | escape }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.edp-buttons-with-icon.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.edp-buttons-with-icon.settings.heading.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-edp"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "t:sections.edp-buttons-with-icon.blocks.button.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.edp-buttons-with-icon.blocks.button.settings.icon.label",
          "options": [
            { "value": "truck", "label": "t:sections.edp-icon.options.truck" },
            { "value": "calendar", "label": "t:sections.edp-icon.options.calendar" },
            { "value": "bell", "label": "t:sections.edp-icon.options.bell" },
            { "value": "shield-check", "label": "t:sections.edp-icon.options.shield-check" },
            { "value": "check", "label": "t:sections.edp-icon.options.check" },
            { "value": "star", "label": "t:sections.edp-icon.options.star" },
            { "value": "leaf", "label": "t:sections.edp-icon.options.leaf" },
            { "value": "phone", "label": "t:sections.edp-icon.options.phone" },
            { "value": "drop", "label": "t:sections.edp-icon.options.drop" },
            { "value": "building", "label": "t:sections.edp-icon.options.building" },
            { "value": "lightning", "label": "t:sections.edp-icon.options.lightning" },
            { "value": "compass", "label": "t:sections.edp-icon.options.compass" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "label", "label": "t:sections.edp-buttons-with-icon.blocks.button.settings.label.label", "default": "Länketikett" },
        { "type": "url", "id": "link", "label": "t:sections.edp-buttons-with-icon.blocks.button.settings.link.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.edp-buttons-with-icon.presets.name",
      "blocks": [
        { "type": "button", "settings": { "icon": "truck", "label": "Snabb leverans" } },
        { "type": "button", "settings": { "icon": "shield-check", "label": "Garanti & support" } },
        { "type": "button", "settings": { "icon": "leaf", "label": "GPSR & CE" } },
        { "type": "button", "settings": { "icon": "phone", "label": "Kundtjänst" } }
      ]
    }
  ]
}
{% endschema %}
