{{ 'section-enterprise.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Produktfilm från tillverkarens YouTube-kanal, laddad först när besökaren
  klickar. Fram till dess visas bara YouTubes egen miniatyr, så inga
  YouTube-cookies sätts av att sidan öppnas. Uppspelningen går via
  youtube-nocookie.com. Film-ID:n hämtas från src/data/product-videos.json
  och skrivs in i mallarna av scripts/wisson/build-pages.mjs.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign video_id = section.settings.youtube_id | strip -%}
{%- if video_id != blank -%}
  {%- assign video_title = section.settings.heading | default: section.settings.credit | default: 'Produktfilm' -%}
  <div class="edp-enterprise color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding isolate">
      <div class="edp-video{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
          <div class="edp-video__intro">
            {%- unless section.settings.eyebrow == blank -%}
              <span class="edp-enterprise__eyebrow">{{ section.settings.eyebrow | escape }}</span>
            {%- endunless -%}
            {%- unless section.settings.heading == blank -%}
              <h2 class="edp-video__title h2">{{ section.settings.heading | escape }}</h2>
            {%- endunless -%}
            {%- unless section.settings.text == blank -%}
              <p class="edp-video__text">{{ section.settings.text | escape }}</p>
            {%- endunless -%}
          </div>
        {%- endif -%}

        <div
          class="edp-video__player"
          data-edp-video
          data-video-id="{{ video_id | escape }}"
          data-video-title="{{ video_title | escape }}"
        >
          <button type="button" class="edp-video__poster" data-edp-video-play aria-label="Spela upp: {{ video_title | escape }}">
            <img
              src="https://i.ytimg.com/vi/{{ video_id | escape }}/maxresdefault.jpg"
              alt=""
              loading="lazy"
              width="1280"
              height="720"
              onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ video_id | escape }}/hqdefault.jpg'"
            >
            <span class="edp-video__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" focusable="false"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
            </span>
          </button>
        </div>

        {%- unless section.settings.credit == blank -%}
          <p class="edp-video__credit">
            {{ section.settings.credit | escape }}
            &middot;
            <a href="https://www.youtube.com/watch?v={{ video_id | escape }}" target="_blank" rel="noopener">Se på YouTube</a>
          </p>
        {%- endunless -%}
      </div>
    </div>
  </div>

  <script>
    (function () {
      var root = document.currentScript.previousElementSibling;
      var player = root && root.querySelector('[data-edp-video]');
      var button = player && player.querySelector('[data-edp-video-play]');
      if (!player || !button) return;
      button.addEventListener('click', function () {
        var id = player.getAttribute('data-video-id');
        var iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0&modestbranding=1';
        iframe.title = player.getAttribute('data-video-title') || '';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('frameborder', '0');
        player.replaceChild(iframe, button);
        player.classList.add('edp-video__player--active');
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Produktfilm",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "youtube_id",
      "label": "YouTube-ID",
      "info": "Det 11 tecken långa ID:t i filmens webbadress, t.ex. r3t5Rj9Lth8. Använd bara filmer från tillverkarens egen kanal."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Överrubrik",
      "default": "Film"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Se systemet i arbete"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "credit",
      "label": "Källa",
      "info": "Visas under filmen, t.ex. \"Film: Wisson Robotics\"."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-edp"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Produktfilm"
    }
  ]
}
{% endschema %}
