{{ 'edp-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="edp-brand-logos color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank -%}
      <h2 class="edp-brand-logos__heading h2">{{ section.settings.heading | escape }}</h2>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="edp-brand-logos__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="edp-brand-logos__item" {{ block.shopify_attributes }}>
            {%- liquid
              assign tag = 'div'
              if block.settings.link != blank
                assign tag = 'a'
              endif
            -%}
            <{{ tag }}
              {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
              class="edp-brand-logos__link"
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 300
                  | image_tag: class: 'edp-brand-logos__image', loading: 'lazy', widths: '100,150,200,300', alt: block.settings.name
                }}
              {%- else -%}
                <span class="edp-brand-logos__name">{{ block.settings.name | escape }}</span>
              {%- endif -%}
            </{{ tag }}>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.edp-brand-logos.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.edp-brand-logos.settings.heading.label",
      "default": "Auktoriserad återförsäljare & partner"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-edp"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.edp-brand-logos.blocks.logo.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.edp-brand-logos.blocks.logo.settings.image.label" },
        { "type": "text", "id": "name", "label": "t:sections.edp-brand-logos.blocks.logo.settings.name.label", "default": "Varumärke" },
        { "type": "url", "id": "link", "label": "t:sections.edp-brand-logos.blocks.logo.settings.link.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.edp-brand-logos.presets.name",
      "blocks": [
        { "type": "logo", "settings": { "name": "DJI" } },
        { "type": "logo", "settings": { "name": "Wisson" } },
        { "type": "logo", "settings": { "name": "Drone Volt" } },
        { "type": "logo", "settings": { "name": "CE" } },
        { "type": "logo", "settings": { "name": "GPSR" } }
      ]
    }
  ]
}
{% endschema %}
