{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}

<div class="page-width">
  <h1 class="title title--primary inline-richtext{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ section.settings.title }}
  </h1>

  {%- assign has_visible_group = false -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.collections.size > 0 -%}
      {%- assign has_visible_group = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if has_visible_group -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign group_collections = block.settings.collections
        if group_collections.size == 0
          continue
        endif
      -%}
      <div class="collection-list-group" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h2 class="collection-list-group__heading h2 inline-richtext{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
            {{ block.settings.heading }}
          </h2>
        {%- endif -%}
        <ul
          class="collection-list grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
          role="list"
        >
          {%- for collection in group_collections -%}
            <li
              class="collection-list__item grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% render 'card-collection',
                card_collection: collection,
                media_aspect_ratio: section.settings.image_ratio,
                columns: section.settings.columns_desktop
              %}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  {%- elsif request.design_mode -%}
    <div class="collection-list-group collection-list-group--empty">
      <p class="collection-list-group__empty-text">
        {{ 'sections.main-list-collections.no_groups' | t }}
      </p>
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "t:sections.main-list-collections.name",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.main-list-collections.settings.title.label",
      "default": "t:sections.main-list-collections.settings.title.default"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-list-collections.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.main-list-collections.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-list-collections.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-list-collections.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "2",
      "label": "t:sections.main-list-collections.settings.columns_mobile.label"
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "t:sections.main-list-collections.blocks.group.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.main-list-collections.blocks.group.settings.heading.label",
          "default": "t:sections.main-list-collections.blocks.group.settings.heading.default"
        },
        {
          "type": "collection_list",
          "id": "collections",
          "label": "t:sections.main-list-collections.blocks.group.settings.collections.label",
          "info": "t:sections.main-list-collections.blocks.group.settings.collections.info"
        }
      ]
    }
  ],
  "max_blocks": 20
}
{% endschema %}
