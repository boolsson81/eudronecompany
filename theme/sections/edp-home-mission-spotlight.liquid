{{ 'edp-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="edp-home-mission color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank and section.settings.text == blank -%}
      <div class="edp-home-mission__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {%- unless section.settings.heading == blank -%}
          <h2 class="edp-home-mission__heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endunless -%}
        {%- unless section.settings.text == blank -%}
          <p class="edp-home-mission__text">{{ section.settings.text | escape }}</p>
        {%- endunless -%}
      </div>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="edp-home-mission__pills" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="edp-home-mission__pill">
              {{ block.settings.label | escape }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.feature_title != blank or section.settings.feature_image != blank -%}
      <div class="edp-home-mission__feature">
        <div class="edp-home-mission__feature-content">
          {%- unless section.settings.feature_eyebrow == blank -%}
            <span class="edp-home-mission__feature-eyebrow">{{ section.settings.feature_eyebrow | escape }}</span>
          {%- endunless -%}
          {%- unless section.settings.feature_title == blank -%}
            <h3 class="edp-home-mission__feature-title">{{ section.settings.feature_title | escape }}</h3>
          {%- endunless -%}
          {%- unless section.settings.feature_text == blank -%}
            <p class="edp-home-mission__feature-text">{{ section.settings.feature_text | escape }}</p>
          {%- endunless -%}
          {%- if section.settings.feature_button_label != blank -%}
            <a href="{{ section.settings.feature_button_link | default: '#' }}" class="button button--secondary">
              {{ section.settings.feature_button_label | escape }}
            </a>
          {%- endif -%}
        </div>
        <div class="edp-home-mission__feature-media">
          {%- if section.settings.feature_image != blank -%}
            {{
              section.settings.feature_image
              | image_url: width: 900
              | image_tag:
                class: 'edp-home-mission__feature-image',
                loading: 'lazy',
                widths: '450, 650, 900',
                alt: section.settings.feature_image.alt | default: section.settings.feature_title
            }}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.edp-home-mission-spotlight.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.edp-home-mission-spotlight.settings.heading.label",
      "default": "Uppdragslösningar för din bransch"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.edp-home-mission-spotlight.settings.text.label",
      "default": "Vårt enterprise-team matchar drönare, payload och mjukvara mot uppdraget — inte tvärtom."
    },
    { "type": "header", "content": "Utvalt uppdrag" },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "t:sections.edp-home-mission-spotlight.settings.feature_image.label"
    },
    {
      "type": "text",
      "id": "feature_eyebrow",
      "label": "t:sections.edp-home-mission-spotlight.settings.feature_eyebrow.label",
      "default": "Lantbruk"
    },
    {
      "type": "text",
      "id": "feature_title",
      "label": "t:sections.edp-home-mission-spotlight.settings.feature_title.label",
      "default": "Sprutning & fältkartläggning"
    },
    {
      "type": "textarea",
      "id": "feature_text",
      "label": "t:sections.edp-home-mission-spotlight.settings.feature_text.label",
      "default": "En komplett konfiguration för storskalig precisionssprutning och multispektral fältanalys — plattform, payload, mjukvara och service i ett paket."
    },
    {
      "type": "text",
      "id": "feature_button_label",
      "label": "t:sections.edp-home-mission-spotlight.settings.feature_button_label.label",
      "default": "Se rekommenderad konfiguration"
    },
    { "type": "url", "id": "feature_button_link", "label": "t:sections.edp-home-mission-spotlight.settings.feature_button_link.label" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-edp"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "t:sections.edp-home-mission-spotlight.blocks.pill.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.edp-home-mission-spotlight.blocks.pill.settings.label.label",
          "default": "Bransch"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.edp-home-mission-spotlight.blocks.pill.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.edp-home-mission-spotlight.presets.name",
      "blocks": [
        { "type": "pill", "settings": { "label": "Lantbruk", "link": "/pages/jordbruk" } },
        { "type": "pill", "settings": { "label": "Bygg & inspektion", "link": "/pages/bygg-anlaggning" } },
        { "type": "pill", "settings": { "label": "Säkerhet & räddning", "link": "/pages/raddningstjanst" } },
        { "type": "pill", "settings": { "label": "Kartläggning & lantmäteri", "link": "/pages/gis-kartlaggning" } },
        { "type": "pill", "settings": { "label": "Energi & telekom", "link": "/pages/energi-infrastruktur" } },
        { "type": "pill", "settings": { "label": "Fönster-, tak- & fasadtvätt", "link": "/pages/fasadtvatt-dronare" } }
      ]
    }
  ]
}
{% endschema %}
