{{ 'edp-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- for block in section.blocks -%}
    #MissionTab-{{ block.id }}:checked ~ .edp-home-mission__panels .edp-home-mission__feature[data-panel="{{ block.id }}"] {
      display: grid;
    }
    #MissionTab-{{ block.id }}:checked ~ .edp-home-mission__pills label[for="MissionTab-{{ block.id }}"] {
      background: rgb(var(--edp-accent, 0, 163, 224));
      border-color: rgb(var(--edp-accent, 0, 163, 224));
      color: #fff;
    }
  {%- endfor -%}
{%- endstyle -%}

<div class="edp-home-mission color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank and section.settings.text == blank -%}
      <div class="edp-home-mission__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {%- unless section.settings.heading == blank -%}
          <h2 class="edp-home-mission__heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endunless -%}
        {%- unless section.settings.text == blank -%}
          <p class="edp-home-mission__text">{{ section.settings.text | escape }}</p>
        {%- endunless -%}
      </div>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <input
          type="radio"
          name="edp-home-mission-{{ section.id }}"
          id="MissionTab-{{ block.id }}"
          class="edp-tabs__radio"
          {% if forloop.first %}checked{% endif %}
        >
      {%- endfor -%}

      <div class="edp-home-mission__pills" role="tablist">
        {%- for block in section.blocks -%}
          <label for="MissionTab-{{ block.id }}" class="edp-home-mission__pill" {{ block.shopify_attributes }}>
            {{ block.settings.label | escape }}
          </label>
        {%- endfor -%}
      </div>

      <div class="edp-home-mission__panels">
        {%- for block in section.blocks -%}
          {%- liquid
            assign panel_eyebrow = block.settings.feature_eyebrow | default: block.settings.label
            assign panel_button_link = block.settings.feature_button_link | default: block.settings.link
          -%}
          {%- if block.settings.feature_title != blank or block.settings.feature_image != blank -%}
            <div class="edp-home-mission__feature" data-panel="{{ block.id }}">
              <div class="edp-home-mission__feature-content">
                {%- unless panel_eyebrow == blank -%}
                  <span class="edp-home-mission__feature-eyebrow">{{ panel_eyebrow | escape }}</span>
                {%- endunless -%}
                {%- unless block.settings.feature_title == blank -%}
                  <h3 class="edp-home-mission__feature-title">{{ block.settings.feature_title | escape }}</h3>
                {%- endunless -%}
                {%- unless block.settings.feature_text == blank -%}
                  <p class="edp-home-mission__feature-text">{{ block.settings.feature_text | escape }}</p>
                {%- endunless -%}
                {%- if block.settings.feature_button_label != blank -%}
                  <a href="{{ panel_button_link | default: '#' }}" class="button button--secondary">
                    {{ block.settings.feature_button_label | escape }}
                  </a>
                {%- endif -%}
              </div>
              <div class="edp-home-mission__feature-media">
                {%- if block.settings.feature_image != blank -%}
                  {{
                    block.settings.feature_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'edp-home-mission__feature-image',
                      loading: 'lazy',
                      widths: '450, 650, 900',
                      alt: block.settings.feature_image.alt | default: block.settings.feature_title
                  }}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.edp-home-mission-spotlight.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.edp-home-mission-spotlight.settings.heading.label",
      "default": "Uppdragslösningar för din bransch"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.edp-home-mission-spotlight.settings.text.label",
      "default": "Vårt enterprise-team matchar drönare, payload och mjukvara mot uppdraget — inte tvärtom."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-edp"
    },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "t:sections.edp-home-mission-spotlight.blocks.pill.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.edp-home-mission-spotlight.blocks.pill.settings.label.label",
          "default": "Bransch"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.edp-home-mission-spotlight.blocks.pill.settings.link.label",
          "info": "Används som knapplänk i fliken om ingen egen länk anges nedan."
        },
        { "type": "header", "content": "Innehåll i fliken" },
        {
          "type": "image_picker",
          "id": "feature_image",
          "label": "t:sections.edp-home-mission-spotlight.settings.feature_image.label"
        },
        {
          "type": "text",
          "id": "feature_eyebrow",
          "label": "t:sections.edp-home-mission-spotlight.settings.feature_eyebrow.label",
          "info": "Standard: samma text som flikens namn ovan."
        },
        {
          "type": "text",
          "id": "feature_title",
          "label": "t:sections.edp-home-mission-spotlight.settings.feature_title.label"
        },
        {
          "type": "textarea",
          "id": "feature_text",
          "label": "t:sections.edp-home-mission-spotlight.settings.feature_text.label"
        },
        {
          "type": "text",
          "id": "feature_button_label",
          "label": "t:sections.edp-home-mission-spotlight.settings.feature_button_label.label"
        },
        {
          "type": "url",
          "id": "feature_button_link",
          "label": "t:sections.edp-home-mission-spotlight.settings.feature_button_link.label",
          "info": "Lämna tom för att använda länken ovan."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.edp-home-mission-spotlight.presets.name",
      "blocks": [
        {
          "type": "pill",
          "settings": {
            "label": "Lantbruk",
            "link": "/pages/jordbruk",
            "feature_eyebrow": "Lantbruk",
            "feature_title": "Sprutning & fältkartläggning",
            "feature_text": "En komplett konfiguration för storskalig precisionssprutning och multispektral fältanalys — plattform, payload, mjukvara och service i ett paket.",
            "feature_button_label": "Se rekommenderad konfiguration"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Bygg & inspektion",
            "link": "/pages/bygg-anlaggning",
            "feature_eyebrow": "Bygg & inspektion",
            "feature_title": "3D-modellering & bygguppföljning",
            "feature_text": "Fotogrammetri, punktmoln och regelbundna flygningar ger exakt volymberäkning och avvikelseanalys mot BIM-modellen — snabbare och säkrare än manuell mätning.",
            "feature_button_label": "Se rekommenderad konfiguration"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Säkerhet & räddning",
            "link": "/pages/raddningstjanst",
            "feature_eyebrow": "Säkerhet & räddning",
            "feature_title": "Perimeterbevakning & räddningsinsats",
            "feature_text": "Termisk kamera och realtidsvideo ger omedelbar överblick vid larm, eftersökning och bevakning av kritisk infrastruktur — dygnet runt.",
            "feature_button_label": "Se rekommenderad konfiguration"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Kartläggning & lantmäteri",
            "link": "/pages/gis-kartlaggning",
            "feature_eyebrow": "Kartläggning & lantmäteri",
            "feature_title": "Volymberäkning & terrängmodeller",
            "feature_text": "RTK-precision ger centimeternoggranna ortomosaiker, DTM/DSM och volymberäkningar för mätning, planering och exploatering.",
            "feature_button_label": "Se rekommenderad konfiguration"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Energi & telekom",
            "link": "/pages/energi-infrastruktur",
            "feature_eyebrow": "Energi & telekom",
            "feature_title": "Ledningsinspektion & termisk analys",
            "feature_text": "Termisk kamera och optisk zoom identifierar hotspots i kraftledningar, transformatorer och master — utan driftstopp eller helikopter.",
            "feature_button_label": "Se rekommenderad konfiguration"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Fönster-, tak- & fasadtvätt",
            "link": "/pages/fasadtvatt-dronare",
            "feature_eyebrow": "Fönster-, tak- & fasadtvätt",
            "feature_title": "Rengöring på höjd utan ställning",
            "feature_text": "Specialdrönare rengör fönster, tak och fasader på höjd — snabbare, säkrare och helt utan byggnadsställning.",
            "feature_button_label": "Se rekommenderad konfiguration"
          }
        }
      ]
    }
  ]
}
{% endschema %}
