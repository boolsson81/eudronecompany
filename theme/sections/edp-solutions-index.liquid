{% comment %}
  Uppdragslösningar — hubbsida som listar alla `solution_package`-metaobjekt
  (onlineStore urlHandle: "solutions"). Fristående sektion (main-typ), till
  skillnad från edp-solution-package.liquid som renderar en enskild post via
  closest.metaobject. Används i templates/page.uppdragslosningar.json.
{% endcomment %}
{{ 'edp-payload.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign quote_link = section.settings.quote_link | default: '/pages/contact-quote'
  assign packages = shop.metaobjects.solution_package.values
-%}

<div class="edp-payload color-{{ section.settings.color_scheme }}">
  <div class="edp-payload__wrap">

    <nav class="edp-payload__breadcrumb" aria-label="Brödsmula">
      <a href="/">Hem</a>
      <span aria-hidden="true">/</span>
      <a href="/pages/enterprise">Enterprise</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ section.settings.heading | default: 'Uppdragslösningar' | escape }}</span>
    </nav>

    <header class="edp-payload__hero">
      <p class="edp-payload__eyebrow">Enterprise</p>
      <h1 class="edp-payload__title">{{ section.settings.heading | default: 'Uppdragslösningar' | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="edp-payload__lede">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="edp-cta-row">
        <a href="{{ quote_link }}" class="button">Begär Enterprise-offert</a>
      </div>
    </header>

    {%- if packages != blank -%}
      <section class="edp-payload__section">
        <div class="edp-payload__grid">
          {%- for pkg in packages -%}
            <a class="edp-payload__card" href="{{ pkg.url }}">
              {%- if pkg.mission.value.industry.value != blank -%}
                <p class="edp-payload__card-eyebrow">{{ pkg.mission.value.industry.value | replace: '-', ' ' | capitalize }}</p>
              {%- endif -%}
              <p class="edp-payload__card-title">{{ pkg.name.value | escape }}</p>
              {%- if pkg.description.value != blank -%}
                <p class="edp-payload__card-text">{{ pkg.description.value | strip_html | truncate: 130 }}</p>
              {%- endif -%}
              {%- if pkg.components_summary.value != blank -%}
                <ul class="edp-payload__pills">
                  {%- for c in pkg.components_summary.value limit: 3 -%}
                    <li class="edp-payload__pill">{{ c | escape }}</li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      </section>
    {%- else -%}
      <section class="edp-payload__section">
        <p class="edp-payload__prose edp-payload__spec-not-specified">
          Inga uppdragslösningar är publicerade ännu. Kontakta vårt enterprise-team för en konfiguration anpassad efter ditt uppdrag.
        </p>
      </section>
    {%- endif -%}

    <section class="edp-payload__banner">
      <h2 class="edp-payload__banner-title">Hittar du inte rätt lösning för ditt uppdrag?</h2>
      <p class="edp-payload__banner-text">Vårt enterprise-team bygger en komplett konfiguration av drönare, payload, mjukvara och service utifrån din verksamhet.</p>
      <div class="edp-cta-row">
        <a href="{{ quote_link }}" class="button">Begär Enterprise-offert</a>
        <a href="/pages/contact-us" class="button button--secondary" data-edp-event="contact_expert_clicked">Prata med en expert</a>
      </div>
    </section>

  </div>
</div>
<script src="{{ 'edp-analytics.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    window.dispatchEvent(new CustomEvent('edp:analytics', { detail: { event: 'solutions_index_view' } }));
  });
</script>

{% schema %}
{
  "name": "Uppdragslösningar (hubb)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Färgschema", "default": "scheme-edp" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Uppdragslösningar" },
    { "type": "textarea", "id": "text", "label": "Ingress", "default": "Färdiga konfigurationer av drönare, payload och mjukvara — matchade mot uppdraget, inte tvärtom." },
    { "type": "url", "id": "quote_link", "label": "Länk till offertformulär" }
  ],
  "presets": [{ "name": "Uppdragslösningar (hubb)" }]
}
{% endschema %}
