{% comment %}
  Payload categories overview — lets the merchant add several
  payload_category entries to any page (e.g. /pages/enterprise).
  One block per category; each renders as a card with the category's
  description, its subcategories and a link to the category page.

  Styles come from assets/edp-payload.css plus the small block below.
{% endcomment %}
{{ 'edp-payload.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #shopify-section-{{ section.id }} .edp-payload-cats {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  #shopify-section-{{ section.id }} .edp-payload-cat {
    gap: 0.75rem;
    padding: 1.5rem;
  }
  #shopify-section-{{ section.id }} .edp-payload-cat__media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  #shopify-section-{{ section.id }} .edp-payload-cat__title { font-size: 1.25rem; font-weight: 600; margin: 0; }
  #shopify-section-{{ section.id }} .edp-payload-cat__text { font-size: 0.9375rem; line-height: 1.55; margin: 0; color: var(--edp-payload-muted); }
  #shopify-section-{{ section.id }} .edp-payload-cat__more { margin-top: auto; font-weight: 600; font-size: 0.9375rem; }
{%- endstyle -%}

<div class="edp-payload color-{{ section.settings.color_scheme }} gradient">
  <div class="edp-payload__wrap section-{{ section.id }}-padding">

    {%- if section.settings.heading != blank -%}
      <h2 class="edp-payload__section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="edp-payload-cat__text" style="margin-bottom:1.5rem">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- liquid
      assign subcategories = shop.metaobjects.payload_subcategory.values
      assign shown = 0
    -%}

    <div class="edp-payload-cats">
      {%- for block in section.blocks -%}
        {%- assign category = block.settings.category -%}
        {%- if category != blank and category.name.value != blank -%}
          {%- assign shown = shown | plus: 1 -%}
          <a class="edp-payload__card edp-payload-cat" href="{{ category.url }}" {{ block.shopify_attributes }}>
            {%- if category.hero_image.value != blank -%}
              <div class="edp-payload-cat__media">
                {{ category.hero_image.value | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600' }}
              </div>
            {%- endif -%}
            <h3 class="edp-payload-cat__title">{{ category.name.value | escape }}</h3>
            {%- if category.short_description.value != blank -%}
              <p class="edp-payload-cat__text">{{ category.short_description.value | truncate: 160 }}</p>
            {%- endif -%}

            {%- if block.settings.show_subcategories and subcategories != blank -%}
              <ul class="edp-payload__pills">
                {%- assign sub_count = 0 -%}
                {%- assign sub_total = 0 -%}
                {%- for sub in subcategories -%}
                  {%- if sub.parent_category.value.system.id == category.system.id -%}
                    {%- assign sub_total = sub_total | plus: 1 -%}
                    {%- if sub_count < block.settings.max_subcategories -%}
                      {%- assign sub_count = sub_count | plus: 1 -%}
                      <li class="edp-payload__pill">{{ sub.name.value | escape }}</li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if sub_total > sub_count -%}
                  <li class="edp-payload__pill">+{{ sub_total | minus: sub_count }}</li>
                {%- endif -%}
              </ul>
            {%- endif -%}

            <span class="edp-payload-cat__more">{{ section.settings.link_label | escape }} &rarr;</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if shown == 0 and request.design_mode -%}
      <p class="edp-payload-cat__text">Lägg till ett block och välj en payload-kategori.</p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Payload-kategorier",
  "tag": "section",
  "class": "section",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Payload-kategorier" },
    { "type": "textarea", "id": "text", "label": "Text under rubriken" },
    { "type": "text", "id": "link_label", "label": "Länktext på korten", "default": "Se kategorin" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Färgschema", "default": "scheme-edp" },
    { "type": "header", "content": "Avstånd" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding topp", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding botten", "default": 36 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Payload-kategori",
      "settings": [
        { "type": "metaobject", "id": "category", "label": "Payload-kategori", "metaobject_type": "payload_category" },
        { "type": "checkbox", "id": "show_subcategories", "label": "Visa underkategorier", "default": true },
        { "type": "range", "id": "max_subcategories", "min": 1, "max": 12, "step": 1, "label": "Max antal underkategorier", "default": 6 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Payload-kategorier",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
