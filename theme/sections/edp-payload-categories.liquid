{% comment %}
  Payload categories overview — lets the merchant add several
  payload_category entries to any page (e.g. /pages/enterprise).
  One block per category; each renders as a card with the category's
  description, its subcategories and a link to the category page.
  Each block can optionally override the category's hero image with its own image.

  Korten är uppbyggda med fast bildyta (samma höjd oavsett bildformat) så att
  rubrik och brödtext hamnar på samma nivå i alla kort, och länkraden
  ("Se kategorin") ligger längst ned i varje kort.

  Styles come from assets/edp-payload.css plus the small block below.
{% endcomment %}
{{ 'edp-payload.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  /* Theme stores --color-foreground as an RGB triplet, which makes color-mix() invalid. Use the text colour instead. */
  #shopify-section-{{ section.id }} .edp-payload { --edp-payload-fg: currentColor; }
  #shopify-section-{{ section.id }} .edp-payload__section-heading { font-size: 28px; margin: 0 0 24px; }
  #shopify-section-{{ section.id }} .edp-payload-cats {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    align-items: stretch;
  }
  #shopify-section-{{ section.id }} a.edp-payload-cat {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    padding: 32px;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    border-radius: 16px;
    background: color-mix(in srgb, currentColor 6%, transparent);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }
  #shopify-section-{{ section.id }} a.edp-payload-cat:hover,
  #shopify-section-{{ section.id }} a.edp-payload-cat:focus-visible {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, currentColor 50%, transparent);
    background: color-mix(in srgb, currentColor 10%, transparent);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }
  #shopify-section-{{ section.id }} a.edp-payload-cat:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  /* Fast bildyta: alla kort får samma höjd på bilden, så rubrikerna startar på samma nivå. */
  #shopify-section-{{ section.id }} .edp-payload-cat__media {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    margin: -8px -8px 4px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .edp-payload-cat__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 10px;
  }
  #shopify-section-{{ section.id }} .edp-payload-cat__title { font-size: 22px; line-height: 1.25; font-weight: 600; margin: 0; }
  #shopify-section-{{ section.id }} .edp-payload-cat__text { font-size: 15px; line-height: 1.6; margin: 0; color: color-mix(in srgb, currentColor 78%, transparent); }
  #shopify-section-{{ section.id }} ul.edp-payload__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} ul.edp-payload__pills li.edp-payload__pill {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 5px 12px;
    font-size: 13px;
    line-height: 1.3;
    white-space: nowrap;
    border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 8%, transparent);
    color: inherit;
  }
  #shopify-section-{{ section.id }} ul.edp-payload__pills li.edp-payload__pill::marker { content: none; }
  #shopify-section-{{ section.id }} .edp-payload-cat__more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    font-weight: 600;
    font-size: 15px;
  }
  #shopify-section-{{ section.id }} .edp-payload-cat__arrow { display: inline-block; font-size: 20px; line-height: 1; transition: transform 0.2s ease; }
  #shopify-section-{{ section.id }} a.edp-payload-cat:hover .edp-payload-cat__arrow,
  #shopify-section-{{ section.id }} a.edp-payload-cat:focus-visible .edp-payload-cat__arrow { transform: translateX(6px); }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .edp-payload-cats { grid-template-columns: 1fr; gap: 16px; }
    #shopify-section-{{ section.id }} a.edp-payload-cat { padding: 24px; }
  }
{%- endstyle -%}

<div class="edp-payload color-{{ section.settings.color_scheme }} gradient">
  <div class="edp-payload__wrap section-{{ section.id }}-padding">

    {%- if section.settings.heading != blank -%}
      <h2 class="edp-payload__section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="edp-payload-cat__text" style="margin-bottom:24px">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- liquid
      assign subcategories = shop.metaobjects.payload_subcategory.values
      assign shown = 0
    -%}

    <div class="edp-payload-cats">
      {%- for block in section.blocks -%}
        {%- assign category = block.settings.category -%}
        {%- if category != blank and category.name.value != blank -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- assign card_image = block.settings.image -%}
          {%- if card_image == blank -%}
            {%- assign card_image = category.hero_image.value -%}
          {%- endif -%}
          <a class="edp-payload__card edp-payload-cat" href="{{ category.url }}" {{ block.shopify_attributes }}>
            {%- comment -%} Bildytan renderas alltid (även utan bild) så att korten hålls i linje. {%- endcomment -%}
            <div class="edp-payload-cat__media">
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', alt: category.name.value }}
              {%- endif -%}
            </div>
            <h3 class="edp-payload-cat__title">{{ category.name.value | escape }}</h3>
            {%- if category.short_description.value != blank -%}
              <p class="edp-payload-cat__text">{{ category.short_description.value | truncate: 160 }}</p>
            {%- endif -%}

            {%- if block.settings.show_subcategories and subcategories != blank -%}
              <ul class="edp-payload__pills">
                {%- assign sub_count = 0 -%}
                {%- assign sub_total = 0 -%}
                {%- for sub in subcategories -%}
                  {%- if sub.parent_category.value.system.id == category.system.id -%}
                    {%- assign sub_total = sub_total | plus: 1 -%}
                    {%- if sub_count < block.settings.max_subcategories -%}
                      {%- assign sub_count = sub_count | plus: 1 -%}
                      <li class="edp-payload__pill">{{ sub.name.value | escape }}</li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if sub_total > sub_count -%}
                  <li class="edp-payload__pill">+{{ sub_total | minus: sub_count }}</li>
                {%- endif -%}
              </ul>
            {%- endif -%}

            <span class="edp-payload-cat__more"><span>{{ section.settings.link_label | escape }}</span><span class="edp-payload-cat__arrow" aria-hidden="true">&rarr;</span></span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if shown == 0 and request.design_mode -%}
      <p class="edp-payload-cat__text">Lägg till ett block och välj en payload-kategori.</p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Payload-kategorier",
  "tag": "section",
  "class": "section",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Payload-kategorier" },
    { "type": "textarea", "id": "text", "label": "Text under rubriken" },
    { "type": "text", "id": "link_label", "label": "Länktext på korten", "default": "Se kategorin" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Färgschema", "default": "scheme-edp" },
    { "type": "header", "content": "Avstånd" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding topp", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding botten", "default": 36 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Payload-kategori",
      "settings": [
        { "type": "metaobject", "id": "category", "label": "Payload-kategori", "metaobject_type": "payload_category" },
        { "type": "image_picker", "id": "image", "label": "Bild", "info": "Valfri. Ersätter kategorins hero-bild på kortet." },
        { "type": "checkbox", "id": "show_subcategories", "label": "Visa underkategorier", "default": true },
        { "type": "range", "id": "max_subcategories", "min": 1, "max": 12, "step": 1, "label": "Max antal underkategorier", "default": 6 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Payload-kategorier",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
