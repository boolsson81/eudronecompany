{
  "sections": {
    "main": {
      "type": "product-information",
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "grid",
            "media_columns": "two",
            "aspect_ratio": "adapt",
            "constrain_to_viewport": true,
            "media_fit": "contain",
            "zoom": true,
            "hide_variants": true,
            "thumbnail_position": "right"
          }
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "custom",
            "custom_width": 100,
            "gap": 12,
            "sticky_details_desktop": true,
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "header": {
              "type": "group",
              "name": "t:names.header",
              "settings": {
                "width": "custom",
                "custom_width": 100,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0,
                "content_direction": "column",
                "horizontal_alignment": "flex-start",
                "vertical_alignment": "center",
                "horizontal_alignment_flex_direction_column": "flex-start",
                "vertical_alignment_flex_direction_column": "center",
                "gap": 4,
                "video_position": "cover",
                "background_image_position": "cover",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100
              },
              "blocks": {
                "vendor": {
                  "type": "text",
                  "settings": {
                    "text": "<p>{{ closest.product.vendor }}</p>",
                    "alignment": "left"
                  }
                },
                "title": {
                  "type": "text",
                  "settings": {
                    "text": "<h1>{{ closest.product.title }}</h1>",
                    "alignment": "left",
                    "type_preset": "h2"
                  },
                  "name": "t:names.product_title"
                },
                "subtitle": {
                  "type": "text",
                  "settings": {
                    "text": "<p>{{ closest.product.metafields.descriptors.subtitle.value }}</p>",
                    "alignment": "left"
                  }
                },
                "price": {
                  "type": "price",
                  "settings": {
                    "show_tax_info": false,
                    "type_preset": "h4",
                    "alignment": "left"
                  }
                }
              },
              "block_order": [
                "vendor",
                "title",
                "subtitle",
                "price"
              ]
            },
            "compatibility": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "{%- assign passar = closest.product.metafields.custom.passsar_till.value -%}{%- if passar != blank -%}<p class=\"edp-compatibility\">Passar till: {{ passar }}</p>{%- endif -%}"
              }
            },
            "divider": {
              "type": "_divider",
              "name": "t:names.divider",
              "settings": {
                "thickness": 1
              }
            },
            "variant_picker": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "padding-block-start": 0,
                "padding-block-end": 8,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "buy_buttons": {
              "type": "buy-buttons",
              "settings": {
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  }
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true
                }
              },
              "block_order": []
            },
            "trust": {
              "type": "group",
              "settings": {
                "width": "custom",
                "custom_width": 100,
                "padding-block-start": 8,
                "padding-block-end": 4,
                "padding-inline-start": 0,
                "padding-inline-end": 0,
                "content_direction": "column",
                "horizontal_alignment": "flex-start",
                "vertical_alignment": "center",
                "horizontal_alignment_flex_direction_column": "flex-start",
                "vertical_alignment_flex_direction_column": "center",
                "gap": 8,
                "video_position": "cover",
                "background_image_position": "cover",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100
              },
              "blocks": {
                "trust-0": {
                  "type": "group",
                  "settings": {
                    "width": "custom",
                    "custom_width": 100,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0,
                    "content_direction": "row",
                    "horizontal_alignment": "flex-start",
                    "vertical_alignment": "center",
                    "horizontal_alignment_flex_direction_column": "flex-start",
                    "vertical_alignment_flex_direction_column": "center",
                    "gap": 12,
                    "video_position": "cover",
                    "background_image_position": "cover",
                    "border": "none",
                    "border_width": 1,
                    "border_opacity": 100
                  },
                  "blocks": {
                    "icon": {
                      "type": "icon",
                      "settings": {
                        "icon": "check_box",
                        "width": 16
                      }
                    },
                    "text": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Auktoriserad DJI Enterprise-partner</p>",
                        "alignment": "left"
                      }
                    }
                  },
                  "block_order": [
                    "icon",
                    "text"
                  ]
                },
                "trust-1": {
                  "type": "group",
                  "settings": {
                    "width": "custom",
                    "custom_width": 100,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0,
                    "content_direction": "row",
                    "horizontal_alignment": "flex-start",
                    "vertical_alignment": "center",
                    "horizontal_alignment_flex_direction_column": "flex-start",
                    "vertical_alignment_flex_direction_column": "center",
                    "gap": 12,
                    "video_position": "cover",
                    "background_image_position": "cover",
                    "border": "none",
                    "border_width": 1,
                    "border_opacity": 100
                  },
                  "blocks": {
                    "icon": {
                      "type": "icon",
                      "settings": {
                        "icon": "price_tag",
                        "width": 16
                      }
                    },
                    "text": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Fakturaköp och leasing för företag</p>",
                        "alignment": "left"
                      }
                    }
                  },
                  "block_order": [
                    "icon",
                    "text"
                  ]
                },
                "trust-2": {
                  "type": "group",
                  "settings": {
                    "width": "custom",
                    "custom_width": 100,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0,
                    "content_direction": "row",
                    "horizontal_alignment": "flex-start",
                    "vertical_alignment": "center",
                    "horizontal_alignment_flex_direction_column": "flex-start",
                    "vertical_alignment_flex_direction_column": "center",
                    "gap": 12,
                    "video_position": "cover",
                    "background_image_position": "cover",
                    "border": "none",
                    "border_width": 1,
                    "border_opacity": 100
                  },
                  "blocks": {
                    "icon": {
                      "type": "icon",
                      "settings": {
                        "icon": "clipboard",
                        "width": 16
                      }
                    },
                    "text": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Utbildning och driftsättning</p>",
                        "alignment": "left"
                      }
                    }
                  },
                  "block_order": [
                    "icon",
                    "text"
                  ]
                }
              },
              "block_order": [
                "trust-0",
                "trust-1",
                "trust-2"
              ]
            },
            "description": {
              "type": "product-description",
              "name": "t:names.product_description"
            },
            "accordion": {
              "type": "accordion",
              "settings": {
                "padding-block-start": 8
              },
              "blocks": {
                "row-0": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Kompatibla modeller"
                  },
                  "blocks": {
                    "text": {
                      "type": "text"
                    }
                  },
                  "block_order": [
                    "text"
                  ]
                },
                "row-1": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Tekniska specifikationer"
                  },
                  "blocks": {
                    "text": {
                      "type": "text"
                    }
                  },
                  "block_order": [
                    "text"
                  ]
                },
                "row-2": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Leverans, garanti & service"
                  },
                  "blocks": {
                    "text": {
                      "type": "text"
                    }
                  },
                  "block_order": [
                    "text"
                  ]
                },
                "row-3": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Dokumentation & nedladdningar"
                  },
                  "blocks": {
                    "text": {
                      "type": "text"
                    }
                  },
                  "block_order": [
                    "text"
                  ]
                }
              },
              "block_order": [
                "row-0",
                "row-1",
                "row-2",
                "row-3"
              ]
            }
          },
          "block_order": [
            "header",
            "compatibility",
            "divider",
            "variant_picker",
            "buy_buttons",
            "trust",
            "description",
            "accordion"
          ]
        }
      },
      "block_order": [],
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "gap": 48,
        "enable_sticky_add_to_cart": true,
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "product": "{{ closest.product }}",
        "recommendation_type": "related",
        "layout_type": "grid",
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 12,
        "rows_gap": 24,
        "section_width": "page-width",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": {
        "header": {
          "type": "text",
          "settings": {
            "text": "<h3>Andra tillbehör till din flotta</h3>",
            "alignment": "left",
            "type_preset": "h3"
          },
          "name": "t:names.header"
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 4
          },
          "blocks": {
            "product-card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "adapt"
              }
            },
            "product_title": {
              "type": "product-title",
              "settings": {
                "width": "fit-content",
                "alignment": "left",
                "type_preset": "paragraph",
                "padding-block-start": 4
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "type_preset": "h6",
                "alignment": "left"
              }
            }
          },
          "block_order": [
            "product-card-gallery",
            "product_title",
            "price"
          ]
        }
      },
      "block_order": [
        "header"
      ]
    },
    "enterprise-quote": {
      "type": "enterprise-quote-form",
      "settings": {
        "title": "Osäker på vilket tillbehör som passar din flotta?",
        "intro": "Beskriv ditt behov så återkommer vårt enterprise-team med rekommendation och offert inom 24 timmar.",
        "color_scheme": "scheme-edp",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "main",
    "recommendations",
    "enterprise-quote"
  ]
}
